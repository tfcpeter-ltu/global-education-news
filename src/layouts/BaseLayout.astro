---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const gaMeasurementId = 'G-JF9Q84LV4Y';
const origin = Astro.site ?? Astro.url.origin;
const absolute = (path = '') => new URL(`${base}${path}`, origin).toString();

const brandDescription = '環球教育新聞（Global Education News）聚焦國際教育新聞、留學政策、全球大學招生、學生簽證與高等教育趨勢，提供各國教育動態、官方政策整理與深度分析。';

const {
  title = '環球教育新聞｜國際教育新聞、留學政策、全球大學招生',
  description = brandDescription,
  image = `${base}images/news-og.jpg`,
  type = 'website',
  noindex = false
} = Astro.props;

const canonical = new URL(Astro.url.pathname, origin).toString();
const imageUrl = new URL(image, origin).toString();
const weeklyFeedUrl = absolute('weekly-feed.xml');
const faviconUrl = absolute('favicon.svg');
const publisherId = `${absolute()}#publisher`;
const websiteId = `${absolute()}#website`;

const publisherLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  '@id': publisherId,
  name: '環球教育新聞',
  alternateName: ['Global Education News', 'LTU Global Education News'],
  description: brandDescription,
  url: absolute(),
  logo: {
    '@type': 'ImageObject',
    url: faviconUrl
  },
  email: 'editor.jsti.ltu@gmail.com',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'editorial',
    email: 'editor.jsti.ltu@gmail.com',
    availableLanguage: ['zh-TW', 'en']
  },
  sameAs: ['https://www.facebook.com/profile.php?id=61585164670358'],
  publishingPrinciples: absolute('editorial-policy/'),
  correctionsPolicy: absolute('corrections/'),
  ownershipFundingInfo: absolute('disclosure/')
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: '環球教育新聞',
  alternateName: 'Global Education News',
  description: brandDescription,
  url: absolute(),
  inLanguage: 'zh-Hant-TW',
  publisher: { '@id': publisherId }
};
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={faviconUrl} type="image/svg+xml" sizes="any" />
    <link rel="shortcut icon" href={faviconUrl} />
    <link rel="alternate" type="application/rss+xml" title="Global Education Weekly｜環球教育週報" href={weeklyFeedUrl} />
    <meta property="og:site_name" content="環球教育新聞 | Global Education News" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(publisherLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)}></script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    <script is:inline define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaMeasurementId, {
        anonymize_ip: true,
        send_page_view: true
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
