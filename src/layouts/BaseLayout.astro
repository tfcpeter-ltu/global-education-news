---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;

const {
  title = 'Global Education News｜國際教育新聞網',
  description = '國際教育、全球大學、招生政策、學生流動與教育制度的新聞與深度分析。',
  image = `${base}images/news-og.jpg`,
  type = 'website',
  noindex = false
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const imageUrl = new URL(image, Astro.site ?? Astro.url.origin).toString();
const weeklyFeedUrl = new URL(`${base}weekly-feed.xml`, Astro.site ?? Astro.url.origin).toString();
const faviconUrl = new URL(`${base}favicon.svg`, Astro.site ?? Astro.url.origin).toString();
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: 'Global Education News',
  alternateName: '國際教育新聞網',
  url: new URL(base, Astro.site ?? Astro.url.origin).toString(),
  email: 'editor.jsti.ltu@gmail.com',
  publishingPrinciples: new URL(`${base}editorial-policy/`, Astro.site ?? Astro.url.origin).toString()
};
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={faviconUrl} type="image/svg+xml" sizes="any" />
    <link rel="shortcut icon" href={faviconUrl} />
    <link rel="alternate" type="application/rss+xml" title="Global Education Weekly｜國際教育週報" href={weeklyFeedUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:site_name" content="Global Education News" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)}></script>
    {gaMeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaMeasurementId, {
            anonymize_ip: true,
            send_page_view: true
          });
        </script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
