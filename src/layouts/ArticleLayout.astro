---
import { educationTopics } from '../data/educationTopics';
import { peterProfile } from '../data/peter-profile';
import BaseLayout from './BaseLayout.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import AdPlacement from '../components/AdPlacement.astro';
import { getStoryImageInfo } from '../lib/storyImages';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const absolute = (path = '') => new URL(`${base}${path}`, Astro.site ?? Astro.url.origin).toString();

const {
  frontmatter = {},
  title = frontmatter.title,
  description = frontmatter.description,
  date = frontmatter.date,
  updated = frontmatter.updated,
  author = frontmatter.author ?? 'LTU Global Education News 編輯部',
  category = frontmatter.category ?? '國際教育',
  topic = frontmatter.topic ?? 'admissions',
  sources = frontmatter.sources ?? [],
  disclosure = frontmatter.disclosure,
  image = frontmatter.image
} = Astro.props;

const photo = getStoryImageInfo({ ...frontmatter, title, description, category, topic, image });
const articleImage = /^https?:\/\//i.test(photo.url) ? photo.url : new URL(photo.url, Astro.site ?? Astro.url.origin).toString();
const published = date ? new Date(date) : undefined;
const modified = updated ? new Date(updated) : published;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const isPeter = String(author).toLowerCase().includes('peter');
const authorUrl = isPeter ? absolute('peter/about/') : absolute('about/#editorial-team');
const publisherUrl = absolute();
const publisherId = `${publisherUrl}#publisher`;
const websiteId = `${publisherUrl}#website`;
const citationUrls = Array.isArray(sources)
  ? sources.map((source: { url?: string }) => source?.url).filter(Boolean)
  : [];

const isNews = Astro.url.pathname.startsWith(`${base}news/`);
const topicInfo = educationTopics[topic];
const articleLd = {
  '@context': 'https://schema.org',
  '@type': isNews ? 'NewsArticle' : 'Article',
  headline: title,
  description,
  url: canonical,
  image: [articleImage],
  thumbnailUrl: articleImage,
  datePublished: published?.toISOString(),
  dateModified: modified?.toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${canonical}#webpage` },
  isPartOf: { '@id': websiteId },
  author: isPeter ? peterProfile : {
    '@type': 'Organization',
    name: author,
    url: authorUrl
  },
  publisher: { '@id': publisherId },
  articleSection: category,
  keywords: [...new Set([category, ...(Array.isArray(frontmatter.tags) ? frontmatter.tags : [])])],
  inLanguage: 'zh-Hant-TW',
  isAccessibleForFree: true,
  ...(citationUrls.length > 0 ? { citation: citationUrls } : {})
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: publisherUrl },
    { '@type': 'ListItem', position: 2, name: '最新新聞', item: absolute('news/') },
    { '@type': 'ListItem', position: 3, name: title, item: canonical }
  ]
};

const relatedModules = import.meta.glob('../pages/news/*.md', { eager: true });
const relatedStories = Object.entries(relatedModules)
  .map(([path, mod]: [string, any]) => ({
    ...mod.frontmatter,
    slug: path.replace('../pages/news/', '').replace('.md', '')
  }))
  .filter((story: any) => story.title && story.title !== title && story.topic === topic)
  .sort((a: any, b: any) => new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime())
  .slice(0, 3);

const fmtDate = (value?: Date) => value ? new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Taipei' }).format(value) : '';
const fmtTime = (value?: Date) => value ? new Intl.DateTimeFormat('zh-TW', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Taipei' }).format(value) : '';
---
<BaseLayout title={`${title}｜環球教育新聞網 Global Education News`} description={description} image={articleImage} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={published?.toISOString()} />
    <meta property="article:modified_time" content={modified?.toISOString()} />
    <meta property="article:section" content={category} />
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
  </Fragment>

  <article class="article">
    <div class="page-shell">
      <nav class="article-breadcrumb" aria-label="麵包屑"><a href={absolute()}>首頁</a><span>›</span><a href={absolute('news/')}>最新新聞</a><span>›</span><span>{category}</span></nav>
      <div class="kicker">{category}</div>
      <h1>{title}</h1>
      {description && <p class="deck">{description}</p>}
      <div class="article-meta">
        <span>作者：<a href={authorUrl}>{author}</a></span>
        {published && <span>發布：<time datetime={published.toISOString()}>{fmtDate(published)} {fmtTime(published)}</time></span>}
        {updated && modified && <span>更新：<time datetime={modified.toISOString()}>{fmtDate(modified)} {fmtTime(modified)}</time></span>}
      </div>
      <figure class="article-hero-image">
        <img src={articleImage} alt={photo.alt} loading="eager" referrerpolicy="no-referrer" />
        <figcaption>{photo.source ? <a href={photo.source} target="_blank" rel="noopener noreferrer">{photo.credit}</a> : photo.credit}</figcaption>
      </figure>
      {disclosure && <p class="disclosure"><strong>利益揭露：</strong>{disclosure}</p>}
      <div class="article-body"><slot /></div>
      {sources.length > 0 && (
        <aside class="source-box">
          <strong>官方資料與消息來源</strong>
          <ul>{sources.map((source: { label: string; url: string }) => (<li><a href={source.url} rel="noopener noreferrer">{source.label}</a></li>))}</ul>
        </aside>
      )}
      <AdPlacement placement="N4" format="card" />
      <NewsletterCTA compact={true} />
      <aside class="article-related">
        <strong>延伸閱讀</strong>
        {topicInfo && <p><a href={absolute(`topics/${topic}/`)}>{topicInfo.heading} →</a></p>}
        <p><a href={absolute('international-education/')}>國際教育主題與升學指南 →</a></p>
        {relatedStories.length > 0 ? (
          <ul>
            {relatedStories.map((story: any) => (
              <li><a href={absolute(`news/${story.slug}/`)}>{story.title}</a></li>
            ))}
          </ul>
        ) : (
          <p><a href={absolute('news/')}>查看更多國際教育最新新聞 →</a></p>
        )}
        <p><a href={absolute('news/')}>全部最新新聞 →</a></p>
        <p><a href={absolute('peter/')}>Peter的國際教育講座 →</a></p>
      </aside>
    </div>
  </article>
</BaseLayout>
