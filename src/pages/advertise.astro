---
import BaseLayout from '../layouts/BaseLayout.astro';
const email = 'editor.jsti.ltu@gmail.com';
const sections = [
  { number: '01', title: '綜合新聞首頁', audience: '跨國招生與大學品牌曝光', slots: [['H1','頭條右側廣告卡','NT$25,000'],['H2','頭條後橫幅','NT$20,000'],['F-H','可關閉浮動卡','NT$16,000']], bundle: 'H1＋H2＋F-H：NT$49,000', href: '/?ad-preview=1' },
  { number: '02', title: '國內大學選校', audience: '台灣大學、學院與科系招生', slots: [['U1','選校工具前橫幅','NT$12,000'],['U2','資料庫後卡片','NT$7,000']], bundle: 'U1＋U2：NT$16,000', href: '/taiwan-universities/' },
  { number: '03', title: '海外留學 DIY', audience: '海外大學課程與國家別招生', slots: [['C1','導覽首頁橫幅','NT$10,000'],['C2','單一國家頁橫幅','NT$9,000／國'],['F-C','可關閉浮動卡','NT$6,000']], bundle: 'C2 單一國家＋F-C：NT$12,000', href: '/study-abroad/?ad-preview=1' },
  { number: '04', title: '國際獎學金雷達', audience: '學校獎學金與研究資助資訊', slots: [['S1','精選區外橫幅','NT$11,000'],['F-S','可關閉浮動卡','NT$7,000']], bundle: 'S1＋F-S：NT$15,000', href: '/scholarships/?ad-preview=1' }
];
---
<BaseLayout title="廣告合作與刊例｜環球國際教育新聞" description="環球國際教育新聞四大專區廣告版位、刊例及合作洽詢。">
  <main class="advertise-page">
    <header class="advertise-hero"><div class="shell">
      <div class="eyebrow">GLOBAL EDUCATION NEWS · ADVERTISING</div>
      <h1>廣告合作</h1>
      <p class="hero-summary">讓學校的招生資訊出現在學生閱讀國際教育新聞、比較大學、規劃留學與查找獎學金的頁面。</p>
      <p>環球國際教育新聞提供繁體中文與英文網站。綜合新聞首頁、國內大學選校、海外留學 DIY 和國際獎學金雷達各有獨立版位。</p>
      <a class="button" href="#rates">查看四大專區刊例 ↓</a>
    </div></header>

    <section class="shell intro" aria-labelledby="reasons-title">
      <div class="eyebrow">WHY ADVERTISE</div><h2 id="reasons-title">與學生正在查找的資訊相連</h2>
      <div class="three-col">
        <article><span>01</span><h3>依閱讀情境選版位</h3><p>國內選校、海外留學和獎學金頁各有不同需求，學校可選擇與招生目標相符的頁面。</p></article>
        <article><span>02</span><h3>中文與英文分別投放</h3><p>依招生對象確認素材與語言版本。兩種語言的頁面各自計價，也可以另外組合。</p></article>
        <article><span>03</span><h3>新聞與廣告清楚區隔</h3><p>每個版位標明廣告身分。付費合作不改變新聞選題、校系比較或獎學金搜尋排序。</p></article>
      </div>
    </section>

    <section class="rates" id="rates" aria-labelledby="rates-title"><div class="shell">
      <div class="eyebrow">ADVERTISING RATES</div><h2 id="rates-title">四大專區刊例</h2>
      <p class="rate-intro">創刊期建議價格。新台幣未稅，單一語言、單一版位刊登 30 天；組合方案以同一語言及檔期計算。</p>
      <div class="rate-grid">
        {sections.map((section) => (
          <article class="rate-card">
            <div class="rate-head"><span>{section.number} / 04</span><h3>{section.title}</h3><p>{section.audience}</p></div>
            <div class="rate-lines">{section.slots.map(([code, name, price]) => (
              <div class="rate-line"><span class="code">{code}</span><span>{name}</span><strong>{price}</strong></div>
            ))}</div>
            <div class="rate-foot"><p><strong>組合方案</strong><br />{section.bundle}</p><a href={section.href}>查看實際版位示意 ↗</a></div>
          </article>
        ))}
      </div>
      <p class="disclaimer">目前網站展示招商示意素材。價格不保證曝光、點擊或招生轉換；正式刊期、同類排他、跨語言刊登與素材製作依需求報價。預覽連結會立即顯示浮動卡，一般訪客向下閱讀後才會看到，並可關閉。</p>
    </div></section>

    <section class="shell terms" aria-labelledby="terms-title">
      <div class="eyebrow">刊登方式</div><h2 id="terms-title">素材、揭露與報告</h2>
      <div class="three-col">
        <article><h3>學校提供</h3><p>圖片、招生文案、官方連結、投放語言與預計日期。申請條件、學費、獎學金資格和期限由學校核實。</p></article>
        <article><h3>本站審核</h3><p>廣告顯示明確標籤。學校專欄與專訪另標示「贊助內容」，與編輯報導區分。</p></article>
        <article><h3>刊後資料</h3><p>依實際量測提供頁面瀏覽、廣告點擊與裝置摘要。現階段不以內容頁數推估受眾。</p></article>
      </div>
    </section>

    <section class="contact"><div class="shell"><div class="eyebrow">CONTACT</div><h2>洽談學校廣告合作</h2>
      <p>來信請註明機構名稱、希望刊登的專區、語言、預計檔期與聯絡方式。</p>
      <a class="button" href={`mailto:${email}?subject=${encodeURIComponent('環球國際教育新聞｜廣告合作洽詢')}`}>{email} ↗</a>
    </div></section>
  </main>
</BaseLayout>
<style>
  .advertise-page{background:#fcfaf5;color:#21384d}.shell{width:min(1120px,calc(100% - 40px));margin:auto}
  .advertise-hero{padding:75px 0 78px;background:linear-gradient(125deg,#102b43,#21435c);color:#fff}
  .eyebrow{font:700 .74rem/1.5 Arial,sans-serif;letter-spacing:.17em;color:#ac8450}
  .advertise-hero .eyebrow{color:#d1aa6c}.advertise-hero h1{margin:15px 0;font-size:clamp(2.8rem,6vw,4.6rem);color:#fff}
  .hero-summary{max-width:800px;font-size:clamp(1.25rem,2.4vw,1.65rem);line-height:1.6;font-weight:700}.advertise-hero p:not(.hero-summary){max-width:770px;line-height:1.75;color:#e1e9ec}
  .button{display:inline-block;margin-top:28px;padding:13px 20px;background:#c39c61;color:#112c42;text-decoration:none;font-weight:800}.button:hover,.button:focus-visible{background:#e5c58c;color:#112c42}
  .intro,.terms{padding-top:70px;padding-bottom:75px}.advertise-page h2{margin:10px 0 27px;font-size:clamp(1.8rem,3.2vw,2.5rem);color:#17364d}
  .three-col{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.three-col article{padding:24px;background:#fff;border:1px solid #e0d4c1;border-top:3px solid #ae844a}
  .three-col span{font:700 1.35rem Georgia,serif;color:#ae844a}.three-col h3{margin:10px 0;color:#17364d}.three-col p{margin:0;color:#4b5b66;line-height:1.75}
  .rates{padding:70px 0 73px;background:#f0e9dd}.rate-intro{margin:-12px 0 30px;color:#4b5b66;line-height:1.7}.rate-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}
  .rate-card{display:flex;flex-direction:column;background:#fff;border:1px solid #d2c3aa;box-shadow:0 10px 25px rgba(30,48,62,.06)}.rate-head{padding:24px 26px 20px;border-top:4px solid #a47b40}
  .rate-head>span{font:700 .72rem Arial,sans-serif;letter-spacing:.14em;color:#986e35}.rate-head h3{margin:9px 0 4px;font-size:1.46rem;color:#17364d}.rate-head p{margin:0;color:#5d6870}
  .rate-lines{padding:0 26px;flex:1}.rate-line{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:10px;align-items:center;padding:14px 0;border-top:1px solid #e5dfd5;font-size:.91rem}.code{font:700 .82rem Arial,sans-serif;color:#9b743d}.rate-line strong{white-space:nowrap;color:#17364d}
  .rate-foot{padding:18px 26px 22px;background:#f9f6ef;border-top:1px solid #e5dfd5}.rate-foot p{margin:0 0 12px;line-height:1.6}.rate-foot a{color:#214f6c;font-weight:700;text-underline-offset:3px}.disclaimer{margin:24px 0 0;color:#55616a;line-height:1.75;font-size:.9rem}
  .contact{padding:65px 0 80px;background:#17364d;color:#fff}.contact h2{color:#fff}.contact p{color:#e2e7e8;line-height:1.7}.contact .button{overflow-wrap:anywhere}
  @media(max-width:820px){.three-col,.rate-grid{grid-template-columns:1fr}.advertise-hero{padding:56px 0 60px}.intro,.terms,.rates,.contact{padding-top:52px;padding-bottom:57px}}
  @media(max-width:460px){.shell{width:calc(100% - 28px)}.rate-head,.rate-lines,.rate-foot{padding-left:17px;padding-right:17px}.rate-line{grid-template-columns:43px 1fr;gap:7px}.rate-line strong{grid-column:2}}
</style>
