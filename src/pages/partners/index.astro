---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStoryImageInfo } from '../../lib/storyImages';

const knownPartners = [
  { name: '明道中學', en: 'Mingdao High School', aliases: ['明道中學', 'mingdao'] },
  { name: '僑泰中學', en: 'Chiao Tai High School', aliases: ['僑泰中學', '僑泰高中', 'chiao tai', 'chiaotai'] }
];

const modules = import.meta.glob('../news/*.md', { eager: true });
const articles = Object.values(modules)
  .map((mod: any) => ({ ...mod.frontmatter, url: mod.url }))
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());

const partnerName = (story: any) => {
  if (typeof story.partner === 'string' && story.partner.trim()) return story.partner.trim();
  const haystack = [story.title, story.description, story.school, story.organization]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
  return knownPartners.find((partner) => partner.aliases.some((alias) => haystack.includes(alias.toLowerCase())))?.name ?? '';
};

const partnerStories = articles
  .map((story: any) => ({ ...story, partnerName: partnerName(story) }))
  .filter((story: any) => Boolean(story.partnerName));
---
<BaseLayout
  title="國際教育合作夥伴｜環球教育新聞 Global Education News"
  description="環球教育新聞國際教育合作夥伴專欄，彙整 LTU 合作學校與教育夥伴的校園新聞、國際交流、升學活動與合作成果。"
>
  <div class="container partner-page">
    <header class="partner-page-header">
      <div class="kicker">INTERNATIONAL EDUCATION PARTNERS</div>
      <h1>國際教育合作夥伴</h1>
      <p>彙整 LTU 合作學校與教育夥伴的校園動態、國際交流、升學活動、師生互訪與教育合作成果。</p>
    </header>

    <section class="partner-directory-page" aria-label="合作學校">
      {knownPartners.map((partner) => (
        <article>
          <div class="kicker">EDUCATION PARTNER</div>
          <h2>{partner.name}</h2>
          <p>{partner.en}</p>
        </article>
      ))}
      <article class="more-partners">
        <div class="kicker">PARTNER NETWORK</div>
        <h2>更多合作學校</h2>
        <p>合作夥伴名單與相關新聞將持續更新。</p>
      </article>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2>合作夥伴新聞</h2>
        <span class="muted">PARTNER NEWS · SCHOOL EXCHANGE · EDUCATION COOPERATION</span>
      </div>

      {partnerStories.length > 0 ? (
        <div class="partner-news-grid">
          {partnerStories.map((story: any) => {
            const photo = getStoryImageInfo(story);
            return (
              <article class="partner-card">
                <a class="partner-card-image" href={story.url}>
                  <img src={photo.url} alt={photo.alt} loading="lazy" referrerpolicy="no-referrer" />
                </a>
                <div class="partner-card-body">
                  <div class="kicker">{story.partnerName} · PARTNER NEWS</div>
                  <h3><a href={story.url}>{story.title}</a></h3>
                  <p>{story.description}</p>
                  <div class="partner-card-meta">{new Intl.DateTimeFormat('zh-TW').format(new Date(story.date))}</div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="partner-empty">
          <h3>合作夥伴新聞專欄已建立</h3>
          <p>明道中學、僑泰中學與其他合作學校的相關新聞將在此集中刊登。</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .partner-page { padding-top: 34px; padding-bottom: 60px; }
  .partner-page-header {
    max-width: 850px;
    padding: 28px 0 26px;
    border-top: 4px double var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
  }
  .partner-page-header h1 {
    margin: 7px 0 12px;
    font-family: Georgia, "Noto Serif TC", serif;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    line-height: 1.02;
  }
  .partner-page-header p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }
  .partner-directory-page {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 26px 0 42px;
    border: 1px solid var(--line);
  }
  .partner-directory-page article {
    padding: 23px;
    border-right: 1px solid var(--line);
    background: #fffdf8;
  }
  .partner-directory-page article:last-child { border-right: 0; }
  .partner-directory-page h2 {
    margin: 8px 0 4px;
    font-family: Georgia, "Noto Serif TC", serif;
    font-size: 1.35rem;
  }
  .partner-directory-page p { margin: 0; color: var(--muted); font-size: .8rem; }
  .more-partners { background: #f3efe6 !important; }
  .partner-news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }
  .partner-card { border-top: 3px solid var(--line-dark); background: #fffdf8; }
  .partner-card-image { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--soft); }
  .partner-card-image img { width: 100%; height: 100%; object-fit: cover; }
  .partner-card-body { padding: 17px; }
  .partner-card h3 {
    margin: 7px 0 9px;
    font-family: Georgia, "Noto Serif TC", serif;
    font-size: 1.12rem;
    line-height: 1.38;
  }
  .partner-card p { margin: 0 0 12px; color: var(--muted); font-size: .83rem; line-height: 1.55; }
  .partner-card-meta { color: var(--muted); font-family: Arial, sans-serif; font-size: .68rem; }
  .partner-empty {
    padding: 35px;
    border: 1px solid var(--line);
    background: #f3efe6;
    text-align: center;
  }
  .partner-empty h3 { margin: 0 0 7px; font-family: Georgia, "Noto Serif TC", serif; }
  .partner-empty p { margin: 0; color: var(--muted); }
  @media (max-width: 800px) {
    .partner-directory-page,
    .partner-news-grid { grid-template-columns: 1fr; }
    .partner-directory-page article { border-right: 0; border-bottom: 1px solid var(--line); }
    .partner-directory-page article:last-child { border-bottom: 0; }
  }
</style>
