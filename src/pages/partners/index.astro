---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStoryImageInfo } from '../../lib/storyImages';
import { getPartnerStories, getPartnerSchoolsWithLogos } from '../../lib/partnerNews';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const link = (path = '') => `${base}${path}`;

const modules = import.meta.glob('../news/*.md', { eager: true });
const articles = Object.values(modules)
  .map((mod: any) => ({ ...mod.frontmatter, url: mod.url }));

const partnerStories = getPartnerStories(articles).slice(0, 12);
const partnerSchoolsWithLogos = getPartnerSchoolsWithLogos();
const partnerLogoSrc = (logo = '') => /^https?:\/\//i.test(logo) || logo.startsWith('/') ? logo : link(logo);
---
<BaseLayout
  title="國際教育合作夥伴｜環球教育新聞 Global Education News"
  description="環球教育新聞國際教育合作夥伴專欄，收錄近三個月合作學校的國際教育、校園交流與合作新聞。"
>
  <div class="container partner-page">
    <header class="partner-page-header">
      <div class="kicker">INTERNATIONAL EDUCATION PARTNERS</div>
      <h1>國際教育合作夥伴</h1>
      <p>本專欄彙整合作學校近期的國際教育、交流與合作新聞，僅保留近三個月內容。</p>
    </header>

    <section class="section partner-news-section" aria-label="國際教育合作夥伴新聞">
      <div class="partner-news-panel">
        {partnerStories.length > 0 ? partnerStories.map((story: any) => {
          const photo = getStoryImageInfo(story);
          return (
            <article class="partner-news-row">
              <a class="partner-news-image" href={story.url}>
                <img src={photo.url} alt={photo.alt} loading="lazy" referrerpolicy="no-referrer" />
              </a>
              <div class="partner-news-copy">
                <div class="kicker">PARTNER NEWS</div>
                <h2><a href={story.url}>{story.title}</a></h2>
                <p>{story.description}</p>
                <div class="partner-news-meta">{new Intl.DateTimeFormat('zh-TW').format(new Date(story.date))}</div>
              </div>
            </article>
          );
        }) : (
          <div class="partner-empty" aria-hidden="true"></div>
        )}
      </div>

      {partnerSchoolsWithLogos.length > 0 && (
        <div class="partner-logo-strip" aria-label="合作學校校徽">
          {partnerSchoolsWithLogos.map((school) => (
            <div class="partner-logo-item" title={school.name}>
              <img src={partnerLogoSrc(school.logo ?? '')} alt={`${school.name} 校徽`} loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .partner-page { padding-top: 34px; padding-bottom: 64px; }
  .partner-page-header {
    max-width: 860px;
    padding: 28px 0 26px;
    border-top: 4px double var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
  }
  .partner-page-header h1 {
    margin: 7px 0 12px;
    font-family: Georgia, "Noto Serif TC", serif;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    line-height: 1.02;
  }
  .partner-page-header p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }
  .partner-news-section { margin-top: 28px; }
  .partner-news-panel {
    border: 1px solid var(--line-dark);
    background: #fffdf8;
  }
  .partner-news-row {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 24px;
    padding: 20px;
    border-bottom: 1px solid var(--line);
  }
  .partner-news-row:last-child { border-bottom: 0; }
  .partner-news-image {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--soft);
  }
  .partner-news-image img { width: 100%; height: 100%; object-fit: cover; }
  .partner-news-copy h2 {
    margin: 7px 0 9px;
    font-family: Georgia, "Noto Serif TC", serif;
    font-size: 1.25rem;
    line-height: 1.38;
  }
  .partner-news-copy p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: .88rem;
    line-height: 1.62;
  }
  .partner-news-meta { color: var(--muted); font-family: Arial, sans-serif; font-size: .7rem; }
  .partner-empty { min-height: 120px; }
  .partner-logo-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px 34px;
    margin-top: 24px;
    padding: 22px 18px 4px;
    border-top: 1px solid var(--line);
  }
  .partner-logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 126px;
    height: 68px;
  }
  .partner-logo-item img {
    max-width: 100%;
    max-height: 60px;
    object-fit: contain;
    filter: saturate(.92);
  }
  @media (max-width: 760px) {
    .partner-news-row { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
