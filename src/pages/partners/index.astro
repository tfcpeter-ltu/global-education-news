---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStoryImageInfo } from '../../lib/storyImages';
import { getPartnerStories } from '../../lib/partnerNews';

const modules = import.meta.glob('../news/*.md', { eager: true });
const articles = Object.values(modules)
  .map((mod: any) => ({ ...mod.frontmatter, url: mod.url }));

const partnerStories = getPartnerStories(articles);
---
<BaseLayout
  title="國際教育合作夥伴｜環球教育新聞 Global Education News"
  description="環球教育新聞國際教育合作夥伴專欄，收錄近三個月合作學校的國際教育、校園交流與合作新聞。"
>
  <div class="container partner-page">
    <header class="partner-page-header">
      <div class="kicker">INTERNATIONAL EDUCATION PARTNERS</div>
      <h1>國際教育合作夥伴</h1>
      <p>本專欄彙整合作學校近期的國際教育、交流與合作新聞，僅保留近三個月內容。</p>
    </header>

    <section class="section partner-news-section" aria-label="國際教育合作夥伴新聞">
      {partnerStories.length > 0 ? (
        <div class="partner-news-grid">
          {partnerStories.map((story: any) => {
            const photo = getStoryImageInfo(story);
            return (
              <article class="partner-card">
                <a class="partner-card-image" href={story.url}>
                  <img src={photo.url} alt={photo.alt} loading="lazy" referrerpolicy="no-referrer" />
                </a>
                <div class="partner-card-body">
                  <div class="kicker">PARTNER NEWS</div>
                  <h2><a href={story.url}>{story.title}</a></h2>
                  <p>{story.description}</p>
                  <div class="partner-card-meta">{new Intl.DateTimeFormat('zh-TW').format(new Date(story.date))}</div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="partner-empty" aria-hidden="true"></div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .partner-page { padding-top: 34px; padding-bottom: 64px; }
  .partner-page-header {
    max-width: 860px;
    padding: 28px 0 26px;
    border-top: 4px double var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
  }
  .partner-page-header h1 {
    margin: 7px 0 12px;
    font-family: Georgia, "Noto Serif TC", serif;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    line-height: 1.02;
  }
  .partner-page-header p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
  }
  .partner-news-section { margin-top: 28px; }
  .partner-news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
  }
  .partner-card { border-top: 3px solid var(--line-dark); background: #fffdf8; }
  .partner-card-image { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--soft); }
  .partner-card-image img { width: 100%; height: 100%; object-fit: cover; }
  .partner-card-body { padding: 17px; }
  .partner-card h2 {
    margin: 7px 0 9px;
    font-family: Georgia, "Noto Serif TC", serif;
    font-size: 1.12rem;
    line-height: 1.38;
  }
  .partner-card p { margin: 0 0 12px; color: var(--muted); font-size: .83rem; line-height: 1.55; }
  .partner-card-meta { color: var(--muted); font-family: Arial, sans-serif; font-size: .68rem; }
  .partner-empty {
    min-height: 110px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 800px) {
    .partner-news-grid { grid-template-columns: 1fr; }
  }
</style>
