---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStoryImageInfo } from '../../lib/storyImages';

const modules = import.meta.glob('./*.md', { eager: true });
const articles = Object.values(modules)
  .map((mod: any) => ({ ...mod.frontmatter, url: mod.url }))
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());
---
<BaseLayout title="深度專題｜Global Education News" description="國際教育制度、招生、政策與學生流動的長篇分析與資料專題。">
  <section class="page"><div class="container">
    <div class="kicker">IN DEPTH</div>
    <h1>深度專題</h1>
    <p class="hero-deck">制度比較、政策背景、招生趨勢與學生流動的長篇分析。每篇文章盡量以政府、大學與第一手公開資料交叉整理。</p>
    <hr class="rule" />
    {articles.length > 0 ? (
      <div class="grid-3">
        {articles.map((story: any) => {
          const photo = getStoryImageInfo(story);
          return (
            <article class="card story-card">
              <a class="card-image" href={story.url}><img src={photo.url} alt={photo.alt} loading="lazy" referrerpolicy="no-referrer" /></a>
              <div class="card-content">
                <div class="kicker">{story.category ?? '深度專題'}</div>
                <h3><a href={story.url}>{story.title}</a></h3>
                <p>{story.description}</p>
                <div class="card-meta">{new Intl.DateTimeFormat('zh-TW').format(new Date(story.date))}</div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="muted">深度專題正在整理中。</p>
    )}
  </div></section>
</BaseLayout>