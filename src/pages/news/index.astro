---
import EducationLinks from '../../components/EducationLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStoryImageInfo } from '../../lib/storyImages';
import AdPlacement from '../../components/AdPlacement.astro';
const modules = import.meta.glob('./*.md', { eager: true });
const articles = Object.values(modules)
  .map((mod: any) => ({ ...mod.frontmatter, url: mod.url }))
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const newsOgImage = `${base}images/news-og.jpg`;
---
<BaseLayout pageType="CollectionPage" title="國際教育新聞｜全球大學、留學政策與招生動態｜環球教育新聞網" description="追蹤全球教育新聞、國際學生政策、大學招生與學生簽證，依國家及主題閱讀最新消息，供台灣與海外繁體中文讀者核對來源與適用條件。" image={newsOgImage}>
  <section class="page">
    <div class="container">
      <div class="kicker">LATEST NEWS</div>
      <h1>最新國際教育新聞</h1>
      <p class="hero-deck">追蹤全球教育與升學相關國際新聞，以政府、大學與第一手資料為優先來源，整理新聞背景及對台灣學生的影響。海外讀者請另核對國籍、居留與申請資格。</p>
      <EducationLinks />
      <p><a href="/campus/reports/">校園 × 出國特別報導：學校路徑、學長姐故事與國際交流 →</a></p><hr class="rule" />
      <div class="grid-3">
        {articles.slice(0, 3).map((story: any) => {
          const photo = getStoryImageInfo(story);
          return (
            <article class="card story-card">
              <a class="card-image" href={story.url}><img src={photo.url} alt={photo.alt} loading="lazy" referrerpolicy="no-referrer" /></a>
              <div class="card-content">
                <div class="kicker">{story.category}</div>
                <h3><a href={story.url}>{story.title}</a></h3>
                <p>{story.description}</p>
                <div class="card-meta">{new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei' }).format(new Date(story.date))}</div>
              </div>
            </article>
          );
        })}
      </div>
      <AdPlacement placement="N1" />
      <div class="grid-3">
        {articles.slice(3).map((story: any) => {
          const photo = getStoryImageInfo(story);
          return (
            <article class="card story-card">
              <a class="card-image" href={story.url}><img src={photo.url} alt={photo.alt} loading="lazy" referrerpolicy="no-referrer" /></a>
              <div class="card-content">
                <div class="kicker">{story.category}</div>
                <h3><a href={story.url}>{story.title}</a></h3>
                <p>{story.description}</p>
                <div class="card-meta">{new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei' }).format(new Date(story.date))}</div>
              </div>
            </article>
          );
        })}
      </div>
      <AdPlacement placement="N2" format="card" />
    </div>
  </section>
  <link rel="stylesheet" href="/ads/home-floating.css?v=20260925-n1" />
  <script is:inline src="/ads/section-floating.js?v=20260925-n1"></script>
</BaseLayout>
