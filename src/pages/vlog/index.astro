---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalog from '../../data/vlog-videos.json';
const videos = catalog.filter(v => v.status === 'published').sort((a, b) => a.priority - b.priority);
const featured = videos.filter(v => v.featured);
const first = featured[0] ?? videos[0];
const duration = (value: string) => {
  const [, h = '0', m = '0', s = '0'] = value.match(/^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/) ?? [];
  return Number(h) ? `${h}:${m.padStart(2, '0')}:${s.padStart(2, '0')}` : `${Number(m)}:${s.padStart(2, '0')}`;
};
const sourceLabel = (type: string) => type === 'official' ? '大學官方' : type === 'submission' ? '讀者投稿' : 'Peter 精選';
---

<BaseLayout videoChannel title="留遊學Vlog｜跟著影像看世界校園" description="從 Peter 的留遊學影片到大學官方校園巡禮，用影像探索海外學習、校園生活與升學選擇。" image="/images/daily/2026-10-14/toronto-hart-house.jpg">
  <div class="vlog-page">
    <header class="video-topbar">
      <a class="video-brand" href="/vlog/" aria-label="留遊學Vlog"><span class="brand-play" aria-hidden="true">▶</span><strong>留遊學Vlog</strong><small>TW</small></a>
      <form id="video-search" role="search"><label for="vlog-query" class="sr-only">搜尋影片、學校或國家</label><input id="vlog-query" type="search" placeholder="搜尋影片、學校或國家" /><button type="submit" aria-label="搜尋影片"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="1.6"/></svg></button></form>
      <a class="back-home" href="/">環球教育新聞網 ↗</a>
    </header>
    <nav class="video-sidebar" aria-label="影音頻道導覽">
      <button type="button" data-filter="all" aria-pressed="true"><span aria-hidden="true">⌂</span>頻道首頁</button>
      <button type="button" data-filter="recommended" aria-pressed="false"><span aria-hidden="true">☆</span>Peter 推薦</button>
      <button type="button" data-filter="official" aria-pressed="false"><span aria-hidden="true">▣</span>大學官方</button>
      <button type="button" data-filter="submission" aria-pressed="false"><span aria-hidden="true">⊕</span>讀者投稿</button>
      <a href="/study-abroad/"><span aria-hidden="true">◎</span>留學導航</a>
    </nav>
    <div class="channel-content">
      <div class="filter-row" role="group" aria-label="影片來源篩選">
        <button type="button" data-filter="all" aria-pressed="true">全部影片</button><button type="button" data-filter="recommended" aria-pressed="false">Peter 推薦</button><button type="button" data-filter="peter" aria-pressed="false">Peter 頻道</button><button type="button" data-filter="official" aria-pressed="false">大學官方</button><button type="button" data-filter="submission" aria-pressed="false">讀者投稿</button>
      </div>
      <header class="channel-heading"><div class="channel-avatar" aria-hidden="true">P</div><div><h1>留遊學Vlog</h1><p>Peter 的國際教育影音頻道<span class="channel-dot"> · </span><span>{videos.length}</span> 部影片</p></div><a class="channel-action" href="#submissions">分享你的影片</a></header>
      <section class="featured" aria-labelledby="featured-title">
        <div class="section-top"><h2 id="featured-title">Peter 推薦放映</h2><div class="carousel-tools"><span id="slide-count">1 / {featured.length}</span><button id="slide-prev" type="button" aria-label="上一張精選">‹</button><button id="slide-next" type="button" aria-label="下一張精選">›</button><button id="slide-toggle" type="button" aria-pressed="false"><span class="pause-label">暫停輪播</span><span class="resume-label" hidden>繼續輪播</span></button></div></div>
        <div class="cinema-grid">
          <div class="screen">
            <button id="hero-play" type="button" aria-label="播放精選影片"><img id="hero-image" src={first.thumbnail} alt={first.title} width="1280" height="720" fetchpriority="high" /><span class="play-round" aria-hidden="true">▶</span></button>
            <div id="player-host" hidden><div id="youtube-player"></div></div>
          </div>
          <div class="feature-info">
            <p class="feature-kicker"><span class="red-dot"></span><span id="hero-source">{sourceLabel(first.sourceType)}</span><span aria-hidden="true"> · </span><span id="hero-country">{first.country}</span></p>
            <h2 id="hero-title">{first.title}</h2><p id="hero-description">{first.description}</p>
            <div class="feature-channel"><span class="small-avatar" aria-hidden="true">P</span><span id="hero-channel">{first.channelTitle}</span></div>
            <div class="playback-tools"><button id="video-prev" type="button">← 上一部</button><button id="video-next" type="button">下一部 →</button></div>
            <label class="autoplay"><input id="auto-next" type="checkbox" checked /> 自動播放下一部</label>
            <p class="queue-note">點擊縮圖即可播放，播完最後一部後回到第一部。</p>
            <div id="player-error" class="player-message" role="status" hidden><p>這部影片目前無法在此播放，請改至 YouTube 觀看，或選擇下一部。</p><a id="hero-youtube" href={first.url} target="_blank" rel="noopener noreferrer">在 YouTube 觀看 ↗</a></div>
            <div id="player-blocked" class="player-message" role="status" hidden>瀏覽器已暫停自動播放，請點擊播放器繼續。</div>
          </div>
        </div>
      </section>
      <section class="library" aria-labelledby="library-title">
        <div class="library-heading"><h2 id="library-title">為你推薦</h2><p class="result-count" role="status"><span id="result-count">{videos.length}</span> <span>部影片</span></p></div>
        <div class="video-grid">
          {videos.map(v => <article class="video-card" data-id={v.id} data-url={v.url} data-source={v.sourceType} data-recommended={v.recommended ? 'true' : 'false'} data-featured={v.featured ? 'true' : 'false'}>
            <button class="card-play" type="button" aria-label={v.title}>
              <div class="card-cover"><img src={v.thumbnail} alt={v.title} width="640" height="360" loading="lazy" /><span class="card-play-icon" aria-hidden="true">▶</span><span class="duration">{duration(v.duration)}</span></div>
              <div class="card-title-row"><span class:list={['small-avatar',v.sourceType === 'official' && 'official-avatar']} aria-hidden="true">{v.sourceType === 'official' ? 'U' : 'P'}</span><h3>{v.title}</h3></div>
            </button>
            <div class="card-details"><p class="channel-name">{v.channelTitle}</p><div class="card-meta"><span class="source-label">{v.recommended ? 'Peter 推薦' : sourceLabel(v.sourceType)}</span><span aria-hidden="true"> · </span><time datetime={v.publishedAt}>{v.publishedAt.slice(0,10)}</time></div></div>
            <p class="card-description" hidden>{v.description}</p><span class="country" hidden>{v.country}</span><span class="topic" hidden>{v.topic}</span>
          </article>)}
        </div>
        <div id="no-results" class="empty-state" hidden><h3>目前沒有符合的影片</h3><p>試試其他關鍵字，或切換影片分類。讀者投稿將在收到並審核後陸續加入。</p><button id="reset-search" type="button">顯示全部影片</button></div>
      </section>
      <section id="submissions" class="submission-banner"><div><h2>把你的留遊學故事，放進下一輪播放。</h2><p>歡迎分享校園走讀、交換生活、遊學紀錄與大學介紹。提供你的 YouTube 影片連結與簡介，審核後就能加入這裡。</p></div><a href="mailto:editor.jsti.ltu@gmail.com?subject=Study%20Abroad%20Vlog%20Submission">提供影片連結 ↗</a></section>
      <footer class="video-footer"><p>影片透過 YouTube 原始播放器播放，著作權歸原創作者。影片日期為原始發布日期；招生及活動資訊請以最新官方公告為準。</p><a href="/">Global Education News</a><a href="/privacy/">隱私權政策</a><a href="/contact/">聯絡我們</a></footer>
    </div>
  </div>
<script>
  import { nextVideoIndex, endedVideoIndex } from '../../lib/vlog-playlist.mjs';
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.video-card'));
  const featured = cards.filter(card => card.dataset.featured === 'true');
  const get = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  let current = 0, slide = 0, playing = false, paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let hovering = false, focused = false, loading = false;
  let player: any;
  const win = window as any;
  const show = (card: HTMLElement) => {
    current = cards.indexOf(card);
    const text = (selector: string) => card.querySelector(selector)?.textContent?.trim() ?? '';
    get('hero-title').textContent = text('h3');
    get('hero-description').textContent = text('.card-description');
    get('hero-channel').textContent = text('.channel-name');
    get('hero-source').textContent = text('.source-label');
    get('hero-country').textContent = text('.country');
    const img = card.querySelector('img')!;
    const hero = get<HTMLImageElement>('hero-image'); hero.src = img.src; hero.alt = img.alt;
    get<HTMLAnchorElement>('hero-youtube').href = card.dataset.url!;
    document.querySelectorAll<HTMLButtonElement>('.featured-item').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.video === card.dataset.id)));
    const featureIndex = featured.indexOf(card);
    if (featureIndex >= 0) { slide = featureIndex; get('slide-count').textContent = `${slide + 1} / ${featured.length}`; }
    else get('slide-count').textContent = '—';
    cards.forEach(c => c.classList.toggle('is-playing', playing && c === card));
    get('player-error').hidden = true; get('player-blocked').hidden = true;
  };
  let apiPromise: Promise<void> | undefined;
  function loadAPI() {
    if (win.YT?.Player) return Promise.resolve();
    if (apiPromise) return apiPromise;
    apiPromise = new Promise<void>((resolve, reject) => {
      const timer = setTimeout(() => { apiPromise = undefined; reject(new Error('YouTube API timeout')); }, 15000);
      win.onYouTubeIframeAPIReady = () => { clearTimeout(timer); resolve(); };
      const script = document.createElement('script'); script.src = 'https://www.youtube.com/iframe_api';
      script.onerror = () => { clearTimeout(timer); script.remove(); apiPromise = undefined; reject(new Error('YouTube API unavailable')); };
      document.head.append(script);
    });
    return apiPromise;
  }
  async function play(card: HTMLElement, scroll = false) {
    playing = true; show(card);
    get('hero-play').hidden = true; get('player-host').hidden = false;
    if (scroll) get('featured-title').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
    if (player && !loading) { player.loadVideoById(card.dataset.id); return; }
    if (loading) return;
    loading = true;
    try {
      await loadAPI();
      player = new win.YT.Player('youtube-player', {
        width: '100%', height: '100%', host: 'https://www.youtube-nocookie.com', videoId: cards[current].dataset.id,
        playerVars: { playsinline: 1, rel: 0, origin: location.origin },
        events: {
          onReady: (event: any) => { loading = false; event.target.loadVideoById(cards[current].dataset.id); },
          onStateChange: (event: any) => {
            if (event.data === 1) get('player-blocked').hidden = true;
            if (event.data === 0 && get<HTMLInputElement>('auto-next').checked) {
              void play(cards[endedVideoIndex(current, cards.length, true)]);
            }
          },
          onError: () => { get('player-error').hidden = false; },
          onAutoplayBlocked: () => { get('player-blocked').hidden = false; }
        }
      });
    } catch { loading = false; playing = false; get('player-error').hidden = false; get('hero-play').hidden = false; get('player-host').hidden = true; }
  }
  function preview(direction: number) {
    const card = featured[nextVideoIndex(slide, featured.length, direction)];
    if (playing) void play(card); else show(card);
  }
  get('hero-play').addEventListener('click', () => void play(cards[current]));
  get('video-next').addEventListener('click', () => void play(cards[nextVideoIndex(current, cards.length)]));
  get('video-prev').addEventListener('click', () => void play(cards[nextVideoIndex(current, cards.length, -1)]));
  get('slide-prev').addEventListener('click', () => preview(-1));
  get('slide-next').addEventListener('click', () => preview(1));
  const toggle = get('slide-toggle');
  function updateToggle() { toggle.setAttribute('aria-pressed', String(paused)); toggle.querySelector<HTMLElement>('.pause-label')!.hidden = paused; toggle.querySelector<HTMLElement>('.resume-label')!.hidden = !paused; }
  updateToggle();
  toggle.addEventListener('click', () => { paused = !paused; updateToggle(); });
  const cinema = document.querySelector<HTMLElement>('.featured')!;
  cinema.addEventListener('mouseenter', () => hovering = true);
  cinema.addEventListener('mouseleave', () => hovering = false);
  cinema.addEventListener('focusin', () => focused = true);
  cinema.addEventListener('focusout', event => focused = cinema.contains(event.relatedTarget as Node));
  setInterval(() => { if (!paused && !playing && !hovering && !focused && !document.hidden) preview(1); }, 8000);
  document.querySelectorAll<HTMLButtonElement>('.featured-item').forEach(button => button.addEventListener('click', () => void play(cards.find(c => c.dataset.id === button.dataset.video)!)));
  cards.forEach(card => card.querySelector('button')!.addEventListener('click', () => void play(card, true)));
  let filter = 'all';
  const query = get<HTMLInputElement>('vlog-query');
  function search() {
    const term = query.value.trim().toLocaleLowerCase();
    let count = 0;
    cards.forEach(card => { card.hidden = !((filter === 'all' || filter === card.dataset.source || (filter === 'recommended' && card.dataset.recommended === 'true')) && card.textContent!.toLocaleLowerCase().includes(term)); if (!card.hidden) count++; });
    get('result-count').textContent = String(count); get('no-results').hidden = count > 0;
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.setAttribute('aria-pressed', String(filter === button.dataset.filter)));
  }
  query.addEventListener('input', search);
  get('video-search').addEventListener('submit', event => { event.preventDefault(); search(); });
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => { filter = button.dataset.filter!; search(); }));
  get('reset-search').addEventListener('click', () => { query.value = ''; filter = 'all'; search(); query.focus(); });
</script>
</BaseLayout>

<style>
:global(body:has(.vlog-page)){background:#fff;color:#0f0f0f;font-family:Arial,"Noto Sans TC","Microsoft JhengHei",sans-serif;line-height:1.5}
:global(body:has(.vlog-page) .language-bar){background:#fff!important;color:#606060!important;border-bottom:1px solid #eee!important}
:global(body:has(.vlog-page) .language-inner){min-height:0!important;padding:4px 24px!important;max-width:none!important;justify-content:flex-end!important}
:global(body:has(.vlog-page) .language-label){display:none!important}
:global(body:has(.vlog-page) .language-bar a){padding:3px 9px!important;font-size:11px!important;background:#f2f2f2!important;color:#333!important;border:0!important}
:global(body:has(.vlog-page) .translation-note){font-size:11px!important;margin:0!important;padding:5px 24px!important;background:#fafafa!important}
.vlog-page [hidden]{display:none!important}.vlog-page button,.vlog-page input{font:inherit}.vlog-page button{cursor:pointer}.vlog-page a:hover{color:#0f0f0f}.vlog-page :is(button,a,input):focus-visible{outline:2px solid #065fd4;outline-offset:3px}
.video-topbar{display:flex;align-items:center;gap:30px;min-height:70px;padding:10px 30px 10px 22px;background:white;position:sticky;top:0;z-index:25;border-bottom:1px solid #f4f4f4}
.video-brand{display:flex;align-items:center;gap:8px;white-space:nowrap;min-width:230px}.video-brand strong{font-size:23px;letter-spacing:-1px}.video-brand small{font-size:10px;align-self:flex-start;color:#666;margin-top:4px}.brand-play{display:grid;place-items:center;width:34px;height:24px;border-radius:7px;background:#f03;color:#fff;font-size:12px}
#video-search{display:flex;max-width:650px;flex:1;border:1px solid #c6c6c6;border-radius:24px;height:42px;overflow:hidden;margin:auto}#vlog-query{border:0;background:white;padding:10px 20px;min-width:0;flex:1;font-size:15px;box-shadow:inset 0 1px 2px #eee}#video-search button{border:0;border-left:1px solid #d3d3d3;background:#f8f8f8;padding:0 22px;display:grid;place-items:center}.back-home{font-size:12px;white-space:nowrap;color:#606060}
.video-sidebar{position:absolute;left:8px;top:115px;width:76px;display:flex;flex-direction:column;gap:10px;z-index:2}.video-sidebar button,.video-sidebar a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;background:white;border:0;border-radius:12px;padding:12px 2px;min-height:75px;font-size:10px;color:#222}.video-sidebar span{font-size:27px;line-height:1}.video-sidebar button:hover,.video-sidebar a:hover{background:#f2f2f2}.video-sidebar [aria-pressed="true"]{background:#f2f2f2;font-weight:700}
.channel-content{margin-left:96px;padding:0 30px 36px 12px;max-width:1900px}.filter-row{display:flex;gap:10px;overflow:auto;scrollbar-width:none;padding:15px 0 12px;white-space:nowrap}.filter-row button{border:0;border-radius:8px;background:#f2f2f2;padding:8px 14px;font-size:13px;font-weight:600;flex:none}.filter-row button[aria-pressed="true"]{background:#0f0f0f;color:#fff}
.channel-heading{display:flex;align-items:center;gap:16px;padding:12px 0 20px;border-bottom:1px solid #eee}.channel-avatar{border-radius:50%;display:grid;place-items:center;width:58px;height:58px;flex:none;background:#172b3d;color:#fff;font-size:29px;font-weight:700}.channel-heading h1{font-size:27px;line-height:1.2;margin:0 0 7px;font-weight:750}.channel-heading p{font-size:12px;color:#606060;margin:0}.channel-action{margin-left:auto;border-radius:22px;padding:10px 18px;background:#0f0f0f;color:white!important;font-size:13px;font-weight:600}
.featured{padding:18px 0 25px;border-bottom:1px solid #eee}.section-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;gap:12px}.section-top h2{font-size:17px;margin:0}.carousel-tools{display:flex;align-items:center;gap:8px;font-size:11px;color:#606060}.carousel-tools button{border:0;background:#f2f2f2;border-radius:20px;min-width:30px;padding:5px 10px;color:#111;font-size:13px}.carousel-tools #slide-prev,.carousel-tools #slide-next{font-size:22px;padding:0;width:30px;height:30px}.cinema-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,1fr);gap:28px;max-width:1200px;margin:0 auto;align-items:center}
.screen{position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:12px;background:#000}#hero-play{display:block;border:0;padding:0;width:100%;height:100%;background:#000;position:relative}#hero-image{width:100%;height:100%;object-fit:contain}.play-round{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:68px;height:48px;border-radius:12px;display:grid;place-items:center;padding-left:3px;background:#000b;color:white;font-size:24px}#hero-play:hover .play-round{background:#f03}#player-host{position:absolute;inset:0}#player-host :global(iframe){border:0;width:100%;height:100%}
.feature-info{padding:10px 0;min-width:0}.feature-kicker{font-size:11px;color:#606060;display:flex;align-items:center;gap:5px;margin:0 0 10px}.red-dot{height:7px;width:7px;border-radius:50%;background:#f03;margin-right:3px}#hero-title{font-size:clamp(19px,1.8vw,26px);line-height:1.4;margin:0 0 12px;font-weight:700}#hero-description{font-size:13px;color:#606060;line-height:1.7;margin:0 0 16px}.feature-channel{display:flex;gap:10px;align-items:center;font-size:12px;color:#333}.small-avatar{display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:50%;background:#172b3d;color:#fff;font-size:17px;font-weight:600}.official-avatar{background:#635b40}
.playback-tools{display:flex;gap:8px;margin-top:18px}.playback-tools button{border:0;border-radius:20px;background:#f2f2f2;padding:9px 15px;font-size:12px;font-weight:600}.autoplay{display:flex;align-items:center;gap:7px;font-size:12px;margin-top:14px;cursor:pointer}.autoplay input{accent-color:#0f0f0f;width:16px;height:16px}.queue-note{font-size:11px;color:#777;margin:9px 0 0}.player-message{padding:10px;background:#fff1e9;font-size:12px;margin-top:12px;border-radius:8px}.player-message a{color:#065fd4;text-decoration:underline}
