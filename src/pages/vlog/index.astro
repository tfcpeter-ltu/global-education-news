---
import BaseLayout from '../../layouts/BaseLayout.astro';
import catalog from '../../data/vlog-videos.json';
const videos = catalog.filter(v => v.status === 'published').sort((a, b) => a.priority - b.priority);
const featured = videos.filter(v => v.featured);
const first = featured[0] ?? videos[0];
const duration = (value: string) => {
  const [, h = '0', m = '0', s = '0'] = value.match(/^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/) ?? [];
  return Number(h) ? `${h}:${m.padStart(2, '0')}:${s.padStart(2, '0')}` : `${Number(m)}:${s.padStart(2, '0')}`;
};
const sourceLabel = (type: string) => type === 'official' ? '大學官方' : type === 'submission' ? '讀者投稿' : 'Peter 精選';
---
<BaseLayout title="留遊學Vlog｜跟著影像看世界校園" description="從 Peter 的留遊學影片到大學官方校園巡禮，用影像探索海外學習、校園生活與升學選擇。" image="/images/daily/2026-10-14/toronto-hart-house.jpg">
  <div class="vlog-page container">
    <header class="vlog-heading">
      <div><p class="eyebrow">WATCH · EXPLORE · GO FURTHER</p><h1>留遊學Vlog</h1><p class="intro">下一站的生活，先從一段影片開始。</p></div>
      <a class="channel-link" href="https://www.youtube.com/channel/UCpQEfgKcfpTvhO768DopAuA" target="_blank" rel="noopener noreferrer"><span class="youtube-mark" aria-hidden="true">▶</span> Peter 的 YouTube 頻道 ↗</a>
    </header>

    <section class="featured" aria-labelledby="featured-title">
      <div class="section-top"><h2 id="featured-title">焦點放映</h2><div class="carousel-tools"><span id="slide-count">1 / {featured.length}</span><button id="slide-prev" type="button" aria-label="上一張精選">←</button><button id="slide-next" type="button" aria-label="下一張精選">→</button><button id="slide-toggle" type="button" aria-pressed="false"><span class="pause-label">暫停輪播</span><span class="resume-label" hidden>繼續輪播</span></button></div></div>
      <div class="cinema-grid">
        <div class="main-feature">
          <div class="screen">
            <button id="hero-play" type="button" aria-label="播放精選影片">
              <img id="hero-image" src={first.thumbnail} alt={first.title} width="1280" height="720" fetchpriority="high" />
              <span class="hero-shade"></span><span class="play-round" aria-hidden="true">▶</span><span class="screen-label">點擊播放 · 開啟校園之旅</span>
            </button>
            <div id="player-host" hidden><div id="youtube-player"></div></div>
          </div>
          <div class="feature-copy"><p class="feature-kicker"><span id="hero-source">{sourceLabel(first.sourceType)}</span><span aria-hidden="true"> / </span><span id="hero-country">{first.country}</span></p><h2 id="hero-title">{first.title}</h2><p id="hero-description">{first.description}</p><div class="feature-meta"><span id="hero-channel">{first.channelTitle}</span><a id="hero-youtube" href={first.url} target="_blank" rel="noopener noreferrer">在 YouTube 觀看 ↗</a></div></div>
          <div class="playback-tools"><div><button id="video-prev" type="button">← 上一部</button><button id="video-next" type="button">下一部 →</button></div><label><input id="auto-next" type="checkbox" checked /> 自動播放下一部</label></div>
          <p class="queue-note">依下方影片順序連播，播完最後一部後回到第一部。</p>
          <div id="player-error" class="player-message" role="status" hidden>這部影片目前無法在此播放，請改至 YouTube 觀看，或選擇下一部。</div>
          <div id="player-blocked" class="player-message" role="status" hidden>瀏覽器已暫停自動播放，請點擊播放器繼續。</div>
        </div>
        <aside class="featured-list" aria-label="重點影片清單">
          <p class="up-next-label">編輯推薦</p>
          {featured.map((v, index) => <button class="featured-item" type="button" data-video={v.id} aria-pressed={index === 0 ? 'true' : 'false'}><div class="mini-cover"><img src={v.thumbnail} alt="" width="320" height="180" loading="lazy" /><span class="duration">{duration(v.duration)}</span></div><div><span class="mini-category">{sourceLabel(v.sourceType)}</span><h3>{v.title}</h3><small>{v.country} · {v.topic}</small></div></button>)}
          <p class="editor-note">從校園走讀到升學講座，找到適合自己的下一站。</p>
        </aside>
      </div>
    </section>

    <section class="library" aria-labelledby="library-title">
      <div class="library-heading"><div><p class="eyebrow">YOUR WINDOW TO THE WORLD</p><h2 id="library-title">探索影片</h2></div><form id="video-search" role="search"><label for="vlog-query" class="sr-only">搜尋影片、學校或國家</label><input id="vlog-query" type="search" placeholder="搜尋影片、學校或國家" /><button type="submit" aria-label="搜尋影片">搜尋</button></form></div>
      <div class="filter-row" role="group" aria-label="影片來源篩選"><button type="button" data-filter="all" aria-pressed="true">全部影片</button><button type="button" data-filter="peter" aria-pressed="false">Peter 精選</button><button type="button" data-filter="official" aria-pressed="false">大學官方</button><button type="button" data-filter="submission" aria-pressed="false">讀者投稿</button><p class="result-count" role="status"><span id="result-count">{videos.length}</span> <span>部影片</span></p></div>
      <div class="video-grid">
        {videos.map(v => <article class="video-card" data-id={v.id} data-source={v.sourceType} data-featured={v.featured ? 'true' : 'false'}>
          <button class="card-play" type="button" aria-label={v.title}><div class="card-cover"><img src={v.thumbnail} alt={v.title} width="640" height="360" loading="lazy" /><span class="card-play-icon" aria-hidden="true">▶</span><span class="duration">{duration(v.duration)}</span></div><h3>{v.title}</h3></button>
          <div class="card-meta"><span class="source-label">{sourceLabel(v.sourceType)}</span><span class="country">{v.country}</span><span class="topic">{v.topic}</span></div><p class="card-description">{v.description}</p><p class="channel-name">{v.channelTitle}</p><div class="card-footer"><time datetime={v.publishedAt}>{v.publishedAt.slice(0, 10)}</time><a class="original-link" href={v.url} target="_blank" rel="noopener noreferrer">YouTube ↗</a></div>
        </article>)}
      </div>
      <div id="no-results" class="empty-state" hidden><h3>目前沒有符合的影片</h3><p>試試其他關鍵字，或切換影片分類。讀者投稿將在收到並審核後陸續加入。</p><button id="reset-search" type="button">顯示全部影片</button></div>
    </section>
    <section class="submission-banner"><div><p class="eyebrow">YOUR STORY, OUR NEXT STOP</p><h2>把你的留遊學故事，放進下一輪播放。</h2><p>歡迎分享校園走讀、交換生活、遊學紀錄與大學介紹。提供你的 YouTube 影片連結與簡介，審核後就能加入這裡。</p></div><a href="mailto:editor.jsti.ltu@gmail.com?subject=Study%20Abroad%20Vlog%20Submission">提供影片連結 ↗</a></section>
    <p class="source-note">影片透過 YouTube 原始播放器播放，著作權歸原創作者。影片日期為原始發布日期；招生及活動資訊請以最新官方公告為準。</p>
  </div>

<script>
  import { nextVideoIndex, endedVideoIndex } from '../../lib/vlog-playlist.mjs';
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.video-card'));
  const featured = cards.filter(card => card.dataset.featured === 'true');
  const get = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  let current = 0, slide = 0, playing = false, paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let hovering = false, focused = false, loading = false;
  let player: any;
  const win = window as any;
  const show = (card: HTMLElement) => {
    current = cards.indexOf(card);
    const text = (selector: string) => card.querySelector(selector)?.textContent?.trim() ?? '';
    get('hero-title').textContent = text('h3');
    get('hero-description').textContent = text('.card-description');
    get('hero-channel').textContent = text('.channel-name');
    get('hero-source').textContent = text('.source-label');
    get('hero-country').textContent = text('.country');
    const img = card.querySelector('img')!;
    const hero = get<HTMLImageElement>('hero-image'); hero.src = img.src; hero.alt = img.alt;
    get<HTMLAnchorElement>('hero-youtube').href = card.querySelector<HTMLAnchorElement>('.original-link')!.href;
    document.querySelectorAll<HTMLButtonElement>('.featured-item').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.video === card.dataset.id)));
    const featureIndex = featured.indexOf(card);
    if (featureIndex >= 0) { slide = featureIndex; get('slide-count').textContent = `${slide + 1} / ${featured.length}`; }
    else get('slide-count').textContent = '—';
    cards.forEach(c => c.classList.toggle('is-playing', playing && c === card));
    get('player-error').hidden = true; get('player-blocked').hidden = true;
  };
  let apiPromise: Promise<void> | undefined;
  function loadAPI() {
    if (win.YT?.Player) return Promise.resolve();
    if (apiPromise) return apiPromise;
    apiPromise = new Promise<void>((resolve, reject) => {
      const timer = setTimeout(() => { apiPromise = undefined; reject(new Error('YouTube API timeout')); }, 15000);
      win.onYouTubeIframeAPIReady = () => { clearTimeout(timer); resolve(); };
      const script = document.createElement('script'); script.src = 'https://www.youtube.com/iframe_api';
      script.onerror = () => { clearTimeout(timer); script.remove(); apiPromise = undefined; reject(new Error('YouTube API unavailable')); };
      document.head.append(script);
    });
    return apiPromise;
  }
  async function play(card: HTMLElement, scroll = false) {
    playing = true; show(card);
    get('hero-play').hidden = true; get('player-host').hidden = false;
    if (scroll) get('featured-title').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
    if (player && !loading) { player.loadVideoById(card.dataset.id); return; }
    if (loading) return;
    loading = true;
    try {
      await loadAPI();
      player = new win.YT.Player('youtube-player', {
        width: '100%', height: '100%', host: 'https://www.youtube-nocookie.com', videoId: cards[current].dataset.id,
        playerVars: { playsinline: 1, rel: 0, origin: location.origin },
        events: {
          onReady: (event: any) => { loading = false; event.target.loadVideoById(cards[current].dataset.id); },
          onStateChange: (event: any) => {
            if (event.data === 1) get('player-blocked').hidden = true;
            if (event.data === 0 && get<HTMLInputElement>('auto-next').checked) {
              void play(cards[endedVideoIndex(current, cards.length, true)]);
            }
          },
          onError: () => { get('player-error').hidden = false; },
          onAutoplayBlocked: () => { get('player-blocked').hidden = false; }
        }
      });
    } catch { loading = false; playing = false; get('player-error').hidden = false; get('hero-play').hidden = false; get('player-host').hidden = true; }
  }
  function preview(direction: number) {
    const card = featured[nextVideoIndex(slide, featured.length, direction)];
    if (playing) void play(card); else show(card);
  }
  get('hero-play').addEventListener('click', () => void play(cards[current]));
  get('video-next').addEventListener('click', () => void play(cards[nextVideoIndex(current, cards.length)]));
  get('video-prev').addEventListener('click', () => void play(cards[nextVideoIndex(current, cards.length, -1)]));
  get('slide-prev').addEventListener('click', () => preview(-1));
  get('slide-next').addEventListener('click', () => preview(1));
  const toggle = get('slide-toggle');
  function updateToggle() { toggle.setAttribute('aria-pressed', String(paused)); toggle.querySelector<HTMLElement>('.pause-label')!.hidden = paused; toggle.querySelector<HTMLElement>('.resume-label')!.hidden = !paused; }
  updateToggle();
  toggle.addEventListener('click', () => { paused = !paused; updateToggle(); });
  const cinema = document.querySelector<HTMLElement>('.featured')!;
  cinema.addEventListener('mouseenter', () => hovering = true);
  cinema.addEventListener('mouseleave', () => hovering = false);
  cinema.addEventListener('focusin', () => focused = true);
  cinema.addEventListener('focusout', event => focused = cinema.contains(event.relatedTarget as Node));
  setInterval(() => { if (!paused && !playing && !hovering && !focused && !document.hidden) preview(1); }, 8000);
  document.querySelectorAll<HTMLButtonElement>('.featured-item').forEach(button => button.addEventListener('click', () => void play(cards.find(c => c.dataset.id === button.dataset.video)!)));
  cards.forEach(card => card.querySelector('button')!.addEventListener('click', () => void play(card, true)));
  let filter = 'all';
  const query = get<HTMLInputElement>('vlog-query');
  function search() {
    const term = query.value.trim().toLocaleLowerCase();
    let count = 0;
    cards.forEach(card => { card.hidden = !((filter === 'all' || filter === card.dataset.source) && card.textContent!.toLocaleLowerCase().includes(term)); if (!card.hidden) count++; });
    get('result-count').textContent = String(count); get('no-results').hidden = count > 0;
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.setAttribute('aria-pressed', String(filter === button.dataset.filter)));
  }
  query.addEventListener('input', search);
  get('video-search').addEventListener('submit', event => { event.preventDefault(); search(); });
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => { filter = button.dataset.filter!; search(); }));
  get('reset-search').addEventListener('click', () => { query.value = ''; filter = 'all'; search(); query.focus(); });
</script>
</BaseLayout>

<style>
  .vlog-page { padding-top: 40px; padding-bottom: 48px; max-width: 1320px; }
  .vlog-page [hidden] { display: none !important; }
  .vlog-page button,.vlog-page input { font: inherit; }
  .vlog-page button { cursor: pointer; }
  .vlog-page :is(button,a,input):focus-visible { outline: 3px solid #dca946; outline-offset: 4px; }
  .vlog-heading,.section-top,.library-heading,.feature-meta,.playback-tools,.card-footer,.filter-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .vlog-heading { margin-bottom: 32px; }
  .eyebrow { color: #8b4537; font: 700 11px/1.5 system-ui,sans-serif; letter-spacing: .16em; margin: 0 0 9px; }
  h1 { font-size: clamp(34px,4vw,52px); line-height: 1.15; margin: 0; letter-spacing: -.02em; }
  .intro { margin: 12px 0 0; color: #63615c; }
  .channel-link { display:flex; align-items:center; gap: 12px; border: 1px solid #d4cec3; border-radius: 30px; padding: 12px 18px; font-size: 13px; white-space: nowrap; }
  .youtube-mark { display: inline-grid; place-items: center; width: 29px; height: 21px; background: #bd302c; border-radius: 6px; color: white; font-size: 11px; }
  .featured { background: #142833; color: #f9f5ed; border-radius: 16px; padding: 26px; scroll-margin-top: 24px; }
  .section-top { margin-bottom: 20px; }
  .section-top h2 { font-size: 19px; margin: 0; }
  .carousel-tools { display:flex; align-items: center; gap: 8px; font: 12px system-ui,sans-serif; }
  #slide-count { min-width: 40px; font-variant-numeric: tabular-nums; }
  .carousel-tools button,.playback-tools button { border: 1px solid #ffffff40; background: transparent; color: inherit; border-radius: 6px; padding: 7px 11px; }
  .carousel-tools button:hover,.playback-tools button:hover { background:#ffffff17; }
  .cinema-grid { display:grid; grid-template-columns: minmax(0,2.05fr) minmax(0,1fr); gap: 28px; }
  .main-feature { min-width: 0; }
  .screen { aspect-ratio: 16/9; position:relative; background: #070e13; overflow: hidden; border-radius: 10px; }
  #hero-play { display: block; position: relative; padding: 0; border: 0; width: 100%; height: 100%; color: white; background: #070e13; }
  #hero-image { display:block; width:100%; height:100%; object-fit:contain; }
  .hero-shade { position:absolute; inset:0; background:linear-gradient(transparent 55%,#000b); }
  .play-round { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:64px; height:64px; display:grid; place-items:center; padding-left:4px; border-radius:50%; background:#bf4435; box-shadow:0 2px 30px #0004; font-size:24px; }
  #hero-play:hover .play-round { background:#d45644; }
  .screen-label { position:absolute; bottom:20px; left:22px; font-size:13px; }
  #player-host { position:absolute; inset:0; }
  #player-host :global(iframe) { width:100%; height:100%; border:0; }
  .feature-kicker { color:#e5b96e; font: 12px system-ui,sans-serif; margin:20px 0 9px; }
  #hero-title { font-size:clamp(22px,2.4vw,30px); line-height:1.4; margin:0 0 10px; }
  #hero-description { color:#d1d9dd; font-size:14px; line-height:1.8; margin:0 0 16px; }
  .feature-meta { font-size:12px; color:#b9c9d0; flex-wrap:wrap; gap:10px; }
  .feature-meta a { color:#f4d6a0; }
  .playback-tools { border-top:1px solid #ffffff25; margin-top:20px; padding-top:16px; flex-wrap:wrap; gap:12px; font-size:12px; }
  .playback-tools label { display:flex; align-items:center; gap:6px; cursor:pointer; }
  .playback-tools input { accent-color:#e5b96e; width:16px; height:16px; }
  .queue-note { color:#b9c9d0; font-size:11px; margin-bottom:0; }
  .player-message { margin-top:12px; padding:12px; background:#55392a; border-radius:5px; font-size:13px; }
  .up-next-label { font:700 11px system-ui,sans-serif; letter-spacing:.14em; color:#aabfc9; margin:0 0 14px; }
  .featured-item { display:grid; grid-template-columns:42% minmax(0,1fr); align-items:center; width:100%; gap:12px; border:1px solid transparent; padding:8px; margin:0 0 10px; background:transparent; color:inherit; text-align:left; border-radius:8px; }
  .featured-item[aria-pressed="true"] { background:#ffffff0d; border-color:#b59056; }
  .featured-item:hover { background:#ffffff12; }
  .mini-cover,.card-cover { position:relative; aspect-ratio:16/9; background:#0b1117; border-radius:6px; overflow:hidden; }
  .mini-cover img,.card-cover img { width:100%; height:100%; display:block; object-fit:cover; }
  .duration { position:absolute; right:7px; bottom:7px; background:#000d; color:white; padding:2px 5px; border-radius:3px; font:11px/1.4 system-ui,sans-serif; }
  .mini-category { color:#d8b77e; font-size:10px; }
  .featured-item h3 { font-size:13px; line-height:1.55; margin:4px 0; }
  .featured-item small { font-size:10px; color:#b9c9d0; }
  .editor-note { border-top:1px solid #ffffff25; padding-top:18px; color:#b9c9d0; font-size:12px; line-height:1.8; }
  .library { padding-top:48px; }
  .library h2 { font-size:30px; margin:0; }
  #video-search { display:flex; width:380px; max-width:100%; border:1px solid #bdb6a9; border-radius:30px; overflow:hidden; background:#fff9; }
  #vlog-query { border:0; background:transparent; padding:13px 18px; flex:1; min-width:0; font-size:13px; }
  #video-search button { border:0; border-left:1px solid #d7d0c4; background:#e9e4da; padding:0 20px; font-size:13px; }
  .filter-row { justify-content:flex-start; flex-wrap:wrap; gap:9px; margin:24px 0; }
  .filter-row button,#reset-search { border:1px solid #d7d0c4; border-radius:7px; padding:8px 16px; background:transparent; font-size:13px; }
  .filter-row button[aria-pressed="true"] { background:#142833; color:#fff; border-color:#142833; }
  .result-count { margin:0 0 0 auto; font-size:12px; color:#6d6a63; }
  .video-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:32px 24px; }
  .video-card { min-width:0; }
  .card-play { padding:0; border:0; background:transparent; text-align:left; width:100%; color:inherit; }
  .card-cover { border-radius:10px; }
  .card-cover img { transition: transform .25s; }
  .card-play:hover img { transform:scale(1.035); }
  .card-play-icon { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:#000a; color:white; border-radius:50%; width:40px; height:40px; display:grid; place-items:center; font-size:14px; opacity:0; }
  .card-play:hover .card-play-icon,.card-play:focus-visible .card-play-icon { opacity:1; }
  .is-playing .card-cover { outline:3px solid #b07f36; outline-offset:3px; }
  .card-play h3 { font-size:17px; line-height:1.55; margin:12px 0 9px; }
  .card-meta { display:flex; gap:8px; flex-wrap:wrap; font-size:10px; color:#655b4c; }
  .source-label { color:#8d3f32; font-weight:700; }
  .card-description { font-size:13px; line-height:1.75; color:#68645d; margin:10px 0 6px; }
  .channel-name { font-size:12px; margin:0; color:#5e5b55; }
  .card-footer { font:11px system-ui,sans-serif; color:#746e64; margin-top:8px; }
  .card-footer a:hover { text-decoration:underline; }
  .empty-state { text-align:center; padding:44px 20px; background:#eae5dc; border-radius:10px; }
  .empty-state p { color:#68645d; font-size:14px; }
  .submission-banner { margin-top:48px; border-top:1px solid #c9c0b0; border-bottom:1px solid #c9c0b0; padding:30px 0; display:flex; align-items:center; gap:40px; justify-content:space-between; }
  .submission-banner h2 { font-size:24px; margin:0 0 12px; }
  .submission-banner p:not(.eyebrow) { font-size:14px; color:#696258; max-width:690px; margin:0; line-height:1.8; }
  .submission-banner a { background:#142833; color:#fff; border-radius:6px; padding:14px 20px; white-space:nowrap; font-size:13px; }
  .source-note { font-size:11px; color:#797166; line-height:1.8; margin-top:20px; }
