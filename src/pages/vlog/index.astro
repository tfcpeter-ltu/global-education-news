---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VlogPlayer from '../../components/VlogPlayer.astro';
import VlogCard from '../../components/VlogCard.astro';
import catalog from '../../data/vlog-videos.json';
import { vlogGroup } from '../../lib/vlog-categories.mjs';
const videos = catalog.filter(v => v.status === 'published').sort((a,b)=>a.priority-b.priority);
const study = videos.filter(v=>vlogGroup(v)==='study');
const tour = videos.filter(v=>vlogGroup(v)==='tour').sort((a,b)=>Number(b.format==='short')-Number(a.format==='short') || (a.format==='short' ? Date.parse(b.publishedAt)-Date.parse(a.publishedAt) : a.priority-b.priority));
const latestCollection = videos.map(v=>v.collectedAt?.slice(0,10)??'').sort().at(-1)??'';
const dailyPicks = latestCollection ? videos.filter(v=>v.collectedAt?.slice(0,10)===latestCollection).slice(0,6) : [];
const groups = [
  {id:'study',title:'留學影音 Vlog',eyebrow:'STUDY ABROAD',description:'大學探索、校園生活、升學觀點，找到自己的學習方向。',videos:study,first:study.find(v=>v.featured)??study[0]},
  {id:'tour',title:'遊學 Vlog',eyebrow:'STUDY TOURS',description:'寒暑假入班、寄宿生活與營隊體驗，從短影音認識遊學。',videos:tour,first:tour.find(v=>v.format==='short')??tour[0]}
];
---
<BaseLayout videoChannel title="留學影音與遊學 Vlog｜跟著影像看世界校園" description="留學影音與遊學 Vlog 左右雙區：大學校園、學習故事、英國與加拿大寒假入班、寄宿和遊學短影音。" image="/images/daily/2026-10-14/toronto-hart-house.jpg">
  <div class="vlog-page" data-mobile-view="study">
    <header class="video-topbar"><a class="video-brand" href="/vlog/" aria-label="留遊學Vlog"><span class="brand-play" aria-hidden="true">▶</span><strong>留遊學Vlog</strong></a><form id="video-search" role="search"><label class="sr-only" for="vlog-query">搜尋影片、學校或國家</label><input id="vlog-query" type="search" placeholder="搜尋影片、學校或國家" /><button type="submit" aria-label="搜尋影片">搜尋</button></form><a class="back-home" href="/">← 返回環球教育新聞首頁</a></header>
    <div class="channel-content">
      <header class="channel-heading"><div><p class="channel-eyebrow">PETER'S VIDEO CHANNEL</p><h1>跟著影像，探索你的下一站。</h1><p>留學與遊學，兩種出發方式，同樣看見更大的世界。</p></div><a class="channel-action" href="#submissions">分享你的影片</a></header>
      <div class="filter-row" role="group" aria-label="影片來源篩選"><button type="button" data-filter="all" aria-pressed="true">全部影片</button><button type="button" data-filter="recommended" aria-pressed="false">Peter 推薦</button><button type="button" data-filter="peter" aria-pressed="false">Peter 頻道</button><button type="button" data-filter="official" aria-pressed="false">大學官方</button><button type="button" data-filter="submission" aria-pressed="false">讀者投稿</button></div>
      <div class="mobile-switch" role="group" aria-label="切換留學與遊學"><button type="button" data-view="study" aria-pressed="true">留學影音 <span data-count="study">{study.length}</span></button><button type="button" data-view="tour" aria-pressed="false">遊學 Vlog <span data-count="tour">{tour.length}</span></button></div>
      <p class="search-summary" role="status"><span id="result-count">{videos.length}</span> <span>部影片</span><span id="search-active" hidden>・搜尋結果</span></p>
      <div class="vlog-columns">
        {groups.map(group=><section class="channel-column" data-group={group.id} aria-labelledby={`${group.id}-title`}>
          <header class="column-heading"><p>{group.eyebrow}</p><div><h2 id={`${group.id}-title`}>{group.title}</h2><span class="column-count"><span data-column-count={group.id}>{group.videos.length}</span> 部影片</span></div><p class="column-description">{group.description}</p></header>
          {group.first && <VlogPlayer group={group.id} first={group.first} count={group.videos.length} />}
          {group.id==='study' && dailyPicks.length>0 && <section class="daily-picks" aria-labelledby="daily-picks-title"><div class="daily-heading"><h3 id="daily-picks-title">今日精選</h3><time datetime={latestCollection}>{latestCollection}</time></div><p>五則世界校園與教育影片，加一則 LTU 介紹。</p><div class="daily-grid">{dailyPicks.map(v=><button type="button" data-daily-video={v.id} aria-label={v.title}><img src={v.thumbnail} alt={v.title} width="480" height="270" loading="lazy" /><span>{v.title}</span></button>)}</div></section>}
          {group.id==='tour' && <div class="tour-note"><strong>遊學短影音，從這裡開始</strong><p>英國唐頓女王學院、加拿大皇冠高中，以及暑期學校與營隊。LTU 關聯課程介紹；含 AI 旁白或情境示意的影片均在簡介標示。</p></div>}
          <div class="library-heading"><h3>{group.id==='study'?'留學影片庫':'遊學影片庫'}</h3><a href={group.id==='study'?'/study-abroad/':'https://www.ossdtw.com/'} target={group.id==='tour'?'_blank':undefined} rel={group.id==='tour'?'noopener noreferrer':undefined}>{group.id==='study'?'留學導航 ↗':'LTU 課程資訊 ↗'}</a></div>
          <div class="video-grid">{group.videos.map(v=><VlogCard video={v} />)}</div>
          <div class="column-empty" data-empty={group.id} hidden><h3>目前沒有符合的影片</h3><p>試試其他關鍵字，或切換影片分類。</p></div>
        </section>)}
      </div>
      <div id="no-results" class="empty-state" hidden><h3>目前沒有符合的影片</h3><p>試試其他關鍵字，或切換影片分類。</p><button id="reset-search" type="button">顯示全部影片</button></div>
      <section id="submissions" class="submission-banner"><div><h2>把你的留遊學故事，放進下一輪播放。</h2><p>歡迎分享校園走讀、交換生活、遊學紀錄與大學介紹。提供你的 YouTube 影片連結與簡介，審核後就能加入這裡。</p></div><a href="mailto:editor.jsti.ltu@gmail.com?subject=Study%20Abroad%20Vlog%20Submission">提供影片連結 ↗</a></section>
      <footer class="video-footer"><p>影片透過 YouTube 原始播放器播放，著作權歸原創作者。影片日期為原始發布日期；招生及活動資訊請以最新官方公告為準。</p><a href="/">Global Education News</a><a href="/privacy/">隱私權政策</a><a href="/contact/">聯絡我們</a></footer>
    </div>
  </div>
<script>
  import { nextVideoIndex, endedVideoIndex } from '../../lib/vlog-playlist.mjs';
  const page = document.querySelector<HTMLElement>('.vlog-page')!;
  const cards = Array.from(page.querySelectorAll<HTMLElement>('.video-card'));
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const win = window as any;
  let activeGroup = '';
  let apiPromise: Promise<void> | undefined;
  function loadAPI() {
    if(win.YT?.Player) return Promise.resolve();
    if(apiPromise) return apiPromise;
    apiPromise = new Promise<void>((resolve,reject)=>{
      const timer=setTimeout(()=>{apiPromise=undefined;reject(new Error('YouTube API timeout'));},15000);
      win.onYouTubeIframeAPIReady=()=>{clearTimeout(timer);resolve();};
      const script=document.createElement('script');script.src='https://www.youtube.com/iframe_api';
      script.onerror=()=>{clearTimeout(timer);script.remove();apiPromise=undefined;reject(new Error('YouTube API unavailable'));};document.head.append(script);
    });return apiPromise;
  }
  const controllers: Array<{group:string;play:(card:HTMLElement,scroll?:boolean)=>Promise<void>;pause:()=>void}> = [];
  page.querySelectorAll<HTMLElement>('[data-player]').forEach(root=>{
    const group=root.dataset.player!;
    const column=root.closest<HTMLElement>('[data-group]')!;
    const queue=Array.from(column.querySelectorAll<HTMLElement>('.video-card'));
    const role=<T extends HTMLElement=HTMLElement>(name:string)=>root.querySelector<T>(`[data-role="${name}"]`)!;
    const action=(name:string)=>root.querySelector<HTMLButtonElement>(`[data-action="${name}"]`)!;
    let current=Math.max(0,queue.findIndex(c=>c.dataset.id===root.dataset.initial));
    const slides=group==='study'?queue.filter(c=>c.dataset.featured==='true'):queue;
    let player:any, loading=false, playing=false, paused=reducedMotion.matches, hovering=false, focused=false;
    let readinessTimer:ReturnType<typeof setTimeout>|undefined;
    function show(card:HTMLElement){
      current=queue.indexOf(card);
      role<HTMLImageElement>('image').src=card.querySelector<HTMLImageElement>('img')!.src;
      role<HTMLImageElement>('image').alt=card.querySelector('h3')!.textContent!;
      role('title').textContent=card.querySelector('h3')!.textContent;
      role('description').textContent=card.querySelector('.card-description')!.textContent;
      role('country').textContent=card.querySelector('.country')!.textContent;
      role('channel').textContent=card.querySelector('.channel-name')!.textContent;
      role<HTMLAnchorElement>('original').href=card.dataset.url!;
      role('position').textContent=`${current+1} / ${queue.length}`;
      role('error').hidden=true;role('blocked').hidden=true;
      queue.forEach(c=>c.classList.toggle('is-playing',playing&&c===card));
    }
    const pause=()=>{player?.pauseVideo?.();};
    async function play(card:HTMLElement,scroll=false){
      activeGroup=group;
      controllers.filter(c=>c.group!==group).forEach(c=>c.pause());
      playing=true;show(card);clearTimeout(readinessTimer);
      readinessTimer=setTimeout(()=>{if(loading)role('error').hidden=false;},20000);
      root.querySelector<HTMLElement>('.poster-play')!.hidden=true;role('host').hidden=false;
      if(scroll)root.scrollIntoView({behavior:reducedMotion.matches?'instant':'smooth',block:'start'});
      if(player&&!loading){clearTimeout(readinessTimer);player.loadVideoById(card.dataset.id);return;}
      if(loading)return;loading=true;
      try{
        await loadAPI();
        player=new win.YT.Player(`${group}-youtube-player`,{width:'100%',height:'100%',host:'https://www.youtube-nocookie.com',videoId:queue[current].dataset.id,playerVars:{playsinline:1,rel:0,origin:location.origin},events:{
          onReady:(event:any)=>{clearTimeout(readinessTimer);loading=false;if(activeGroup===group)event.target.loadVideoById(queue[current].dataset.id);else event.target.cueVideoById(queue[current].dataset.id);},
          onStateChange:(event:any)=>{if(event.data===1){role('blocked').hidden=true;if(activeGroup!==group)event.target.pauseVideo();}if(event.data===0&&activeGroup===group&&role<HTMLInputElement>('autoplay').checked)void play(queue[endedVideoIndex(current,queue.length,true)]);},
          onError:()=>{clearTimeout(readinessTimer);loading=false;role('error').hidden=false;},
          onAutoplayBlocked:()=>{role('blocked').hidden=false;}
        }});
      }catch{clearTimeout(readinessTimer);loading=false;playing=false;role('error').hidden=false;root.querySelector<HTMLElement>('.poster-play')!.hidden=false;role('host').hidden=true;}
    }
    controllers.push({group,play,pause});show(queue[current]);
    root.querySelector('.poster-play')!.addEventListener('click',()=>void play(queue[current]));
    action('previous').addEventListener('click',()=>void play(queue[nextVideoIndex(current,queue.length,-1)]));
    action('next').addEventListener('click',()=>void play(queue[nextVideoIndex(current,queue.length)]));
    queue.forEach(card=>card.querySelector('button')!.addEventListener('click',()=>void play(card,true)));
    function updateToggle(){action('carousel').setAttribute('aria-pressed',String(paused));role('pause-label').hidden=paused;role('resume-label').hidden=!paused;}
    updateToggle();action('carousel').addEventListener('click',()=>{paused=!paused;updateToggle();});
    root.addEventListener('mouseenter',()=>hovering=true);root.addEventListener('mouseleave',()=>hovering=false);
    root.addEventListener('focusin',()=>focused=true);root.addEventListener('focusout',event=>focused=root.contains(event.relatedTarget as Node));
    setInterval(()=>{if(!paused&&!playing&&!hovering&&!focused&&!document.hidden&&slides.length){const index=slides.indexOf(queue[current]);show(slides[nextVideoIndex(index,slides.length)]);}},8000);
  });
  page.querySelectorAll<HTMLButtonElement>('[data-daily-video]').forEach(button=>button.addEventListener('click',()=>{
    const card=cards.find(c=>c.dataset.id===button.dataset.dailyVideo);
    if(card)void controllers.find(c=>c.group===card.closest<HTMLElement>('[data-group]')!.dataset.group)?.play(card,true);
  }));
  let filter='all';const query=page.querySelector<HTMLInputElement>('#vlog-query')!;
  function search(){
    const term=query.value.trim().toLocaleLowerCase();let total=0;const counts:Record<string,number>={};
    page.dataset.searching=String(Boolean(term)||filter!=='all');
    page.querySelectorAll<HTMLElement>('[data-group]').forEach(column=>{
      let count=0;column.querySelectorAll<HTMLElement>('.video-card').forEach(card=>{card.hidden=!((filter==='all'||filter===card.dataset.source||(filter==='recommended'&&card.dataset.recommended==='true'))&&card.textContent!.toLocaleLowerCase().includes(term));if(!card.hidden)count++;});total+=count;
      counts[column.dataset.group!]=count;
      page.querySelector(`[data-column-count="${column.dataset.group}"]`)!.textContent=String(count);
      page.querySelector(`[data-count="${column.dataset.group}"]`)!.textContent=String(count);
      page.querySelector<HTMLElement>(`[data-empty="${column.dataset.group}"]`)!.hidden=count>0;
    });
    page.querySelector('#result-count')!.textContent=String(total);page.querySelector<HTMLElement>('#no-results')!.hidden=total>0;
    page.querySelector<HTMLElement>('#search-active')!.hidden=!term&&filter==='all';
    if(total>0&&counts[page.dataset.mobileView!]===0){
      const selected=Object.keys(counts).find(key=>counts[key]>0)!;page.dataset.mobileView=selected;
      page.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===selected)));
      controllers.filter(c=>c.group!==selected).forEach(c=>c.pause());
    }
    page.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(filter===b.dataset.filter)));
  }
  query.addEventListener('input',search);page.querySelector('#video-search')!.addEventListener('submit',event=>{event.preventDefault();search();});
  page.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.filter!;search();}));
  page.querySelector('#reset-search')!.addEventListener('click',()=>{query.value='';filter='all';search();query.focus();});
  page.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button=>button.addEventListener('click',()=>{
    const selected=button.dataset.view!;page.dataset.mobileView=selected;
    activeGroup=selected;
    page.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===selected)));
    controllers.filter(c=>c.group!==selected).forEach(c=>c.pause());
    page.querySelector<HTMLElement>(`[data-group="${selected}"]`)!.scrollIntoView({behavior:reducedMotion.matches?'instant':'smooth',block:'start'});
  }));
</script>
</BaseLayout>
<style>
:global(body:has(.vlog-page) .language-bar){position:relative!important;top:auto!important}
:global(body:has(.vlog-page)){overflow-x:clip;overflow-y:visible}
.vlog-page[data-searching="true"] :global(.vlog-player),.vlog-page[data-searching="true"] .daily-picks,.vlog-page[data-searching="true"] .tour-note{display:none}.channel-column{scroll-margin-top:75px}
:global(body:has(.vlog-page)){background:#f8fafc;color:#173349;font-family:Arial,"Noto Sans TC","Microsoft JhengHei",sans-serif;line-height:1.5}:global(body:has(.vlog-page) .language-bar){background:#fff!important;color:#506575!important;border-bottom:1px solid #e7eef4!important}:global(body:has(.vlog-page) .language-inner){min-height:0!important;padding:4px 24px!important;max-width:none!important;justify-content:flex-end!important}:global(body:has(.vlog-page) .language-label){display:none!important}:global(body:has(.vlog-page) .language-bar a){padding:3px 9px!important;font-size:11px!important;background:#eff4f8!important;color:#274d68!important;border:0!important}:global(body:has(.vlog-page) .translation-note){font-size:11px!important;margin:0!important;padding:5px 24px!important;background:#f5f8fb!important}
.vlog-page :global([hidden]){display:none!important}.vlog-page :global(button),.vlog-page input{font:inherit}.vlog-page :global(:is(button,a,input):focus-visible){outline:3px solid #2588c7;outline-offset:3px}.video-topbar{display:flex;align-items:center;gap:30px;padding:14px 30px;background:#fff;border-bottom:1px solid #dfe8ef;position:sticky;top:0;z-index:20}.video-brand{display:flex;align-items:center;gap:9px;white-space:nowrap;color:#12354f;text-decoration:none}.video-brand strong{font-size:23px}.brand-play{display:grid;place-items:center;width:34px;height:25px;border-radius:8px;background:#0877b8;color:white;font-size:12px}#video-search{display:flex;flex:1;max-width:620px;margin:auto;border:1px solid #becfdb;border-radius:24px;overflow:hidden;height:43px}#vlog-query{padding:10px 18px;min-width:0;flex:1;border:0;background:#fff;font-size:14px}#video-search button{border:0;border-left:1px solid #dce7ef;background:#f0f5f9;padding:0 20px;font-size:13px;cursor:pointer;color:#1e4b6c}.back-home{white-space:nowrap;text-decoration:none;font-size:12px;font-weight:700;border:1px solid #c6d7e3;border-radius:22px;padding:10px 15px;color:#234e6b}.channel-content{max-width:1600px;margin:0 auto;padding:0 30px 40px}.channel-heading{display:flex;justify-content:space-between;align-items:center;gap:25px;padding:26px 0 20px}.channel-eyebrow{font-size:10px;letter-spacing:.17em;color:#507897;margin:0 0 9px}.channel-heading h1{font-size:30px;letter-spacing:-.02em;line-height:1.3;margin:0 0 8px;color:#133b58}.channel-heading p:not(.channel-eyebrow){margin:0;font-size:13px;color:#597083}.channel-action{flex:none;color:#fff;background:#143f60;padding:11px 18px;border-radius:22px;font-size:12px;text-decoration:none}.filter-row{display:flex;gap:9px;overflow:auto;padding:0 0 16px;white-space:nowrap}.filter-row button{flex:none;border:1px solid #d9e4ec;background:#fff;border-radius:20px;color:#3e5c72;padding:7px 14px;font-size:12px;cursor:pointer}.filter-row button[aria-pressed="true"]{background:#143f60;color:white;border-color:#143f60}.search-summary{font-size:11px;color:#718494;margin:0 0 12px}.vlog-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px;align-items:start}.channel-column{min-width:0}.column-heading{background:linear-gradient(120deg,#073252,#09649a);padding:19px 22px;border-radius:15px 15px 0 0;color:white;margin-bottom:15px}.channel-column[data-group="tour"] .column-heading{background:linear-gradient(120deg,#116060,#197c81)}.column-heading>p:first-child{font-size:10px;letter-spacing:.18em;color:#a9dff9;margin:0 0 7px}.column-heading>div{display:flex;align-items:center;justify-content:space-between;gap:12px}.column-heading h2{font-size:27px;line-height:1.3;margin:0;color:#fff}.column-count{font-size:11px;border:1px solid #ffffff60;border-radius:15px;padding:4px 9px;white-space:nowrap}.column-heading .column-description{font-size:12px;color:#e0f2fc;margin:9px 0 0;line-height:1.6}.channel-column :global(.vlog-player){scroll-margin-top:90px}.daily-picks{margin:24px 0;background:#eaf3fb;padding:17px;border-radius:13px}.daily-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}.daily-heading h3{font-size:18px;margin:0;color:#154d75}.daily-heading time{font-size:11px;color:#456c88}.daily-picks>p{font-size:11px;color:#56788f;margin:8px 0 13px}.daily-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.daily-grid button{border:0;padding:0;background:#fff;text-align:left;border-radius:8px;overflow:hidden;cursor:pointer;color:#1f4561}.daily-grid img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}.daily-grid span{display:block;font-size:12px;line-height:1.5;padding:8px 10px;font-weight:700}.tour-note{padding:17px 19px;background:#e9f5f4;border:1px solid #d2e8e6;border-radius:12px;margin:24px 0;color:#205c60}.tour-note strong{font-size:14px}.tour-note p{font-size:12px;line-height:1.8;margin:7px 0 0}.library-heading{display:flex;align-items:center;justify