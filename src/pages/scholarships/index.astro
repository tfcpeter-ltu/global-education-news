---
import BaseLayout from '../../layouts/BaseLayout.astro';

const modules = import.meta.glob('./items/*.md', { eager: true });
const scholarships = Object.values(modules)
  .map((mod: any) => ({ ...mod.frontmatter, url: mod.url }))
  .sort((a: any, b: any) => new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime());

const taiwanDate = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
const featured = scholarships.filter((item: any) =>
  item.featuredDate === taiwanDate && item.verificationDate === taiwanDate &&
  item.status === '開放中' && String(item.eligibilityTW).includes('可申請') &&
  Number.isFinite(Date.parse(item.featuredUntil)) && Date.parse(item.featuredUntil) > Date.now()
).slice(0, 3);
const countries = [...new Set(scholarships.map((item: any) => item.country).filter(Boolean))].sort((a: any, b: any) => String(a).localeCompare(String(b), 'zh-Hant'));
const countryCount = countries.length;
const today = new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Taipei' }).format(new Date());
const description = '台灣國際獎學金雷達：從台灣學生角度整理全球大學、研究所、政府與基金會獎學金，每日查核並更新值得申請的機會。';

const flagMap: Record<string, string> = {
  '台灣': '🇹🇼', '英國': '🇬🇧', '美國': '🇺🇸', '加拿大': '🇨🇦', '澳洲': '🇦🇺', '紐西蘭': '🇳🇿',
  '日本': '🇯🇵', '韓國': '🇰🇷', '德國': '🇩🇪', '法國': '🇫🇷', '瑞士': '🇨🇭', '荷蘭': '🇳🇱',
  '瑞典': '🇸🇪', '芬蘭': '🇫🇮', '愛爾蘭': '🇮🇪', '比利時': '🇧🇪', '義大利': '🇮🇹', '新加坡': '🇸🇬',
  '香港': '🇭🇰', '歐盟': '🇪🇺', '德國／歐盟': '🇪🇺', '多國': '🌍', '全球': '🌍'
};
const flagFor = (country = '') => flagMap[country] ?? '🌐';
const statusClass = (status = '') => status.includes('開放中') ? 'open' : status.includes('即將') ? 'soon' : 'watch';
---
<BaseLayout title="台灣國際獎學金雷達｜100+ 全球獎學金資料庫" description={description}>
  <main class="scholarship-page">
    <section class="editorial-hero">
      <div class="ornament ornament-left" aria-hidden="true">✦</div>
      <div class="ornament ornament-right" aria-hidden="true">✦</div>
      <div class="academic-margin margin-left" aria-hidden="true">SCHOLARSHIPS<br/>FELLOWSHIPS<br/>RESEARCH<br/>MOBILITY</div>
      <div class="academic-margin margin-right" aria-hidden="true">OXFORD<br/>CAMBRIDGE<br/>PARIS<br/>ZÜRICH</div>
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="eyebrow">GLOBAL EDUCATION NEWS <span>◆</span> EUROPEAN SCHOLARSHIP REVIEW</div>
          <h1>台灣國際獎學金雷達</h1>
          <p class="hero-subtitle">{scholarships.length}+ 全球獎學金資料庫 <span>｜</span> 每日查核，最多新增 3 則</p>
          <p class="hero-description">從台灣學生的視角，整理全球獎學金、政府補助、研究資助與國際大學機會。以官方來源、台灣資格與截止日為核心，建立可以長期搜尋與追蹤的國際升學資料庫。</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#all-opportunities"><span>▤</span> 立即查看獎學金</a>
            <a class="btn btn-outline" href="#taiwan-programs">台灣官方補助</a>
            <a class="btn btn-outline" href="#today-picks">今日精選</a>
          </div>
          <div class="edition-line"><span>TAIPEI</span><i></i><span>OXFORD · CAMBRIDGE · PARIS · ZÜRICH</span><i></i><span>{today}</span></div>
        </div>

        <aside class="stat-panel" aria-label="獎學金雷達統計">
          <div class="stat-heading">BY THE NUMBERS</div>
          <div class="stat-item"><span class="stat-icon">◎</span><strong>{scholarships.length}+</strong><small>全球機會</small><em>SCHOLARSHIPS</em></div>
          <div class="stat-item"><span class="stat-icon">▥</span><strong>{countryCount}+</strong><small>國家與地區</small><em>COUNTRIES</em></div>
          <div class="stat-item"><span class="stat-icon">◷</span><strong>Daily</strong><small>每日更新</small><em>CURATED DAILY</em></div>
          <div class="stat-item"><span class="stat-icon">◇</span><strong>Verified</strong><small>官方查核</small><em>EDITORIAL REVIEW</em></div>
          <div class="panel-watermark" aria-hidden="true">ACADEMIA</div>
        </aside>
      </div>
    </section>

    <section class="search-section" aria-label="獎學金搜尋與篩選">
      <div class="section-shell">
        <div class="archive-heading">
          <span>SEARCH THE SCHOLARSHIP ARCHIVE</span>
          <strong>搜尋全球獎學金資料庫</strong>
          <p>輸入獎學金名稱、學校、國家或關鍵字，再依學位、補助與申請狀態縮小範圍。</p>
        </div>
        <form id="scholarship-search-form" class="search-panel" role="search">
          <label class="search-box">
            <span class="search-icon" aria-hidden="true">⌕</span>
            <span class="search-copy">
              <span class="search-caption">SCHOLARSHIP · UNIVERSITY · COUNTRY · KEYWORD</span>
              <input id="scholarship-search" type="search" placeholder="搜尋獎學金、學校、國家或關鍵字…" autocomplete="off" />
            </span>
          </label>
          <button class="search-submit" type="submit">搜尋獎學金</button>
          <div class="filter-grid">
            <label class="select-box"><span>◎</span><select id="country-filter" aria-label="國家"><option value="all">國家／地區</option>{countries.map((country: any) => <option value={country}>{country}</option>)}</select></label>
            <label class="select-box"><span>🎓</span><select id="level-filter" aria-label="學位"><option value="all">學位層級</option><option value="大學">大學</option><option value="學士">學士</option><option value="碩士">碩士</option><option value="博士">博士</option><option value="研究">研究</option></select></label>
            <label class="select-box"><span>◇</span><select id="funding-filter" aria-label="補助類型"><option value="all">補助類型</option><option value="全額">全額</option><option value="學費">學費</option><option value="生活">生活費</option><option value="部分">部分補助</option></select></label>
            <label class="select-box"><span>♢</span><select id="status-filter" aria-label="狀態"><option value="all">申請狀態</option><option value="開放中">開放中</option><option value="即將開放">即將開放</option><option value="下一輪">下一輪追蹤</option><option value="年度">年度制</option></select></label>
            <button id="clear-filters" class="clear-btn" type="button">↻ 清除篩選</button>
          </div>
        </form>
      </div>
    </section>

    <section id="all-opportunities" class="editorial-section catalog-section">
      <div class="section-shell">
        <div class="catalog-heading">
          <div>
            <div class="eyebrow dark">THE SCHOLARSHIP ARCHIVE</div>
            <h2>探索全部獎學金</h2>
            <p>Scholarships · Fellowships · Research Funding · International Mobility</p>
          </div>
          <div class="result-summary" aria-live="polite"><strong id="result-count">{scholarships.length}</strong><span>個符合條件的機會</span></div>
        </div>

        <p id="empty-results" role="status" hidden>找不到符合條件的獎學金，請改用其他關鍵字或清除篩選。</p>
        <div class="catalog-grid" id="catalog-grid">
          {scholarships.map((item: any, index: number) => {
            const searchText = [item.title, item.description, item.country, item.level, item.funding, item.status, item.sourceType, item.category].filter(Boolean).join(' ').toLowerCase();
            return (
              <article
                class="catalog-card"
                data-card
                data-index={index}
                data-search={searchText}
                data-country={item.country ?? ''}
                data-level={item.level ?? ''}
                data-funding={item.funding ?? ''}
                data-status={item.status ?? ''}
              >
                <div class="catalog-top">
                  <span class="country-line"><b>{flagFor(item.country)}</b>{item.country}</span>
                  <span class:list={['status-dot', statusClass(item.status)]}>{item.status}</span>
                </div>
                <h3><a href={item.url}>{item.title}</a></h3>
                <div class="catalog-tags"><span>{item.level}</span><span>{item.sourceType}</span></div>
                <dl>
                  <div><dt>補助</dt><dd>{item.funding}</dd></div>
                  <div><dt>截止</dt><dd>{item.deadline}</dd></div>
                </dl>
                <div class="catalog-bottom"><span>✓ 台灣資格已查核</span><a href={item.url}>詳情 →</a></div>
              </article>
            );
          })}
        </div>

        <div class="load-row"><button id="load-more" type="button">顯示更多獎學金 <span>＋</span></button></div>
      </div>
    </section>

    <section id="today-picks" class="editorial-section today-section">
      <div class="section-shell">
        <div class="section-title-row">
          <div>
            <div class="eyebrow dark">EDITOR'S SELECTION</div>
            <h2>今日精選</h2>
          </div>
          <div class="section-date">{today} · Curated &amp; Verified</div>
        </div>

        {featured.length === 0 && <p>今天尚無完成當日查核的精選項目，請利用搜尋查閱資料並回到官方網站確認。</p>}
        <div class="spotlight-grid">
          {featured.map((item: any) => (
            <article class="spotlight-card">
              <div class="spotlight-top">
                <span class="country-line"><b>{flagFor(item.country)}</b>{item.country}</span>
                <span class:list={['status-pill', statusClass(item.status)]}>{item.status}</span>
              </div>
              <div class="spotlight-type">{item.category ?? item.sourceType}</div>
              <h3><a href={item.url}>{item.title}</a></h3>
              <p>{item.description}</p>
              <div class="spotlight-meta">
                <div><span>FUNDING · 補助</span><strong>{item.funding}</strong></div>
                <div><span>LEVEL · 學位</span><strong>{item.level}</strong></div>
                <div><span>DEADLINE · 截止</span><strong>{item.deadline}</strong></div>
              </div>
              <div class="spotlight-footer">
                <span class="tw-check">✓ 台灣學生：{item.eligibilityTW}</span>
                <a href={item.url}>查看申請重點 <span>→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="taiwan-programs" class="taiwan-programs">
      <div class="taiwan-watermark left" aria-hidden="true">MOBILITY</div>
      <div class="taiwan-watermark right" aria-hidden="true">TAIWAN</div>
      <div class="section-shell">
        <div class="center-heading">
          <div class="french-kicker">TAIWAN FUNDING &amp; MOBILITY PROGRAMMES</div>
          <h2>從台灣出發，走向世界</h2>
          <p>從教育部學海系列到公費留學與青年海外圓夢，把台灣本地可用的國際資源納入同一套升學與研究規劃。</p>
        </div>
        <div class="program-pills">
          <a href="https://www.studyabroad.moe.gov.tw/new/index.php/" target="_blank" rel="noopener noreferrer"><span>✈</span>學海飛颺</a>
          <a href="https://www.studyabroad.moe.gov.tw/new/index.php/" target="_blank" rel="noopener noreferrer"><span>◇</span>學海惜珠</a>
          <a href="https://www.studyabroad.moe.gov.tw/new/index.php/" target="_blank" rel="noopener noreferrer"><span>▤</span>學海築夢</a>
          <a href="https://www.studyabroad.moe.gov.tw/new/index.php/" target="_blank" rel="noopener noreferrer"><span>✦</span>新南向學海築夢</a>
          <a href="https://twpathfinder.yda.gov.tw/" target="_blank" rel="noopener noreferrer"><span>↗</span>青年百億海外圓夢</a>
          <a href="https://www.scholarship.moe.gov.tw/scholarship" target="_blank" rel="noopener noreferrer"><span>🎓</span>留學獎學金</a>
          <a href="https://www.scholarship.moe.gov.tw/exam-v2/student/login" target="_blank" rel="noopener noreferrer"><span>▥</span>公費留學</a>
        </div>
      </div>
    </section>


    <section class="verification-section">
      <div class="section-shell verification-grid">
        <div>
          <div class="eyebrow">EDITORIAL &amp; VERIFICATION STANDARD</div>
          <h2>獎學金資料庫，也採用新聞編輯室的查核標準。</h2>
        </div>
        <div class="verification-steps">
          <div><span>01</span><p><strong>Official Source</strong><br />政府、大學、基金會或主辦單位原始公告。</p></div>
          <div><span>02</span><p><strong>Cross-check</strong><br />FAQ、招生頁、官方窗口或可靠來源。</p></div>
          <div><span>03</span><p><strong>Taiwan Eligibility</strong><br />國籍、居住地、學位與申請方式。</p></div>
          <div><span>04</span><p><strong>Deadline Tracking</strong><br />開放、延期、截止與下一年度更新。</p></div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const cards = Array.from(document.querySelectorAll('[data-card]'));
      const search = document.getElementById('scholarship-search');
      const country = document.getElementById('country-filter');
      const level = document.getElementById('level-filter');
      const funding = document.getElementById('funding-filter');
      const status = document.getElementById('status-filter');
      const clear = document.getElementById('clear-filters');
      const loadMore = document.getElementById('load-more');
      const count = document.getElementById('result-count');
      const form = document.getElementById('scholarship-search-form');
      const empty = document.getElementById('empty-results');
      let limit = 24;

      const valueOf = (el) => (el && 'value' in el ? String(el.value) : 'all');
      const apply = () => {
        const q = valueOf(search).trim().toLowerCase();
        const countryValue = valueOf(country);
        const levelValue = valueOf(level);
        const fundingValue = valueOf(funding);
        const statusValue = valueOf(status);
        const matches = cards.filter((card) => {
          const text = (card.dataset.search || '');
          const okSearch = !q || text.includes(q);
          const okCountry = countryValue === 'all' || card.dataset.country === countryValue;
          const okLevel = levelValue === 'all' || (card.dataset.level || '').includes(levelValue);
          const okFunding = fundingValue === 'all' || (card.dataset.funding || '').includes(fundingValue);
          const okStatus = statusValue === 'all' || (card.dataset.status || '').includes(statusValue);
          return okSearch && okCountry && okLevel && okFunding && okStatus;
        });
        cards.forEach((card) => { card.hidden = true; });
        matches.slice(0, limit).forEach((card) => { card.hidden = false; });
        if (empty) empty.hidden = matches.length !== 0;
        if (count) count.textContent = String(matches.length);
        if (loadMore) loadMore.hidden = matches.length <= limit;
      };

      [search, country, level, funding, status].forEach((el) => {
        el?.addEventListener(el === search ? 'input' : 'change', () => { limit = 24; apply(); });
      });
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        limit = 24;
        apply();
        document.getElementById('all-opportunities')?.scrollIntoView({ block: 'start' });
      });
      clear?.addEventListener('click', () => {
        if (search) search.value = '';
        [country, level, funding, status].forEach((el) => { if (el) el.value = 'all'; });
        limit = 24;
        apply();
      });
      loadMore?.addEventListener('click', () => { limit += 24; apply(); });
      apply();
    })();
  </script>
</BaseLayout>

<style>
  .search-submit{display:block;margin:12px 0 0;padding:12px 24px;background:#112b4c;color:white;border:1px solid #a97936;font:inherit;cursor:pointer}
  #empty-results[hidden]{display:none} #empty-results{padding:24px;background:#fff4dd;border:1px solid #c8ad7d}

  :global(html){scroll-behavior:smooth}
  .scholarship-page{--ink:#112b4c;--navy:#071d38;--navy2:#0d3155;--gold:#a97936;--gold2:#d1ad6a;--ivory:#fbf8f0;--paper:#f3ecdf;--burgundy:#7a2632;--green:#2f754d;--line:#d8cab1;background:var(--ivory);color:#1f3047;font-family:"Noto Serif TC",Georgia,"Times New Roman",serif}
  .section-shell,.hero-inner{width:min(1280px,calc(100% - 40px));margin:0 auto}
  .editorial-hero{position:relative;overflow:hidden;padding:68px 0 58px;background:linear-gradient(90deg,rgba(17,43,76,.025) 1px,transparent 1px),linear-gradient(rgba(17,43,76,.018) 1px,transparent 1px),radial-gradient(circle at 12% 12%,rgba(169,121,54,.10),transparent 24%),linear-gradient(180deg,#fffdf8 0%,#f5ede0 100%);background-size:28px 28px,28px 28px,auto,auto;border-top:3px double #b9945a;border-bottom:3px double #b9945a}
  .editorial-hero:before{content:"";position:absolute;inset:12px;border:1px solid rgba(169,121,54,.28);pointer-events:none}.editorial-hero:after{content:"ACADEMIA · EUROPA";position:absolute;right:38px;bottom:12px;color:rgba(17,43,76,.055);font-family:Georgia,serif;font-size:1rem;letter-spacing:.28em}
  .ornament{position:absolute;top:20px;color:var(--gold);font-size:.92rem;z-index:2}.ornament-left{left:28px}.ornament-right{right:28px}
  .academic-margin{position:absolute;top:50%;z-index:0;color:rgba(17,43,76,.13);font-family:Georgia,serif;font-size:.58rem;line-height:1.8;letter-spacing:.20em;writing-mode:vertical-rl;transform:translateY(-50%)}.margin-left{left:18px}.margin-right{right:18px}
  .hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:1.04fr .96fr;gap:48px;align-items:center}
  .eyebrow{font-family:Arial,"Noto Sans TC",sans-serif;font-size:.70rem;letter-spacing:.20em;font-weight:800;color:var(--gold);text-transform:uppercase}.eyebrow span{padding:0 7px}.eyebrow.dark{color:#806235}
  .hero-copy h1{margin:14px 0 10px;color:var(--ink);font-size:clamp(2.7rem,5vw,4.9rem);font-weight:700;letter-spacing:.05em;line-height:1.08;text-wrap:balance}
  .hero-subtitle{margin:0;color:var(--burgundy);font-size:clamp(1.05rem,2vw,1.42rem);font-weight:700;letter-spacing:.055em}.hero-subtitle span{color:#b39462;padding:0 7px}
  .hero-description{max-width:700px;margin:20px 0 0;color:#55534e;font-size:1rem;line-height:1.95}
  .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 20px;border:1px solid #c6a36a;text-decoration:none;font-family:Arial,"Noto Sans TC",sans-serif;font-size:.84rem;font-weight:800;letter-spacing:.04em;transition:.2s ease}.btn-primary{background:var(--navy);border-color:var(--gold2);color:white;box-shadow:inset 0 0 0 3px #0b294a,0 7px 18px rgba(8,30,56,.15)}.btn-primary:hover{background:#0c3155}.btn-primary span{color:#ddb96f;margin-right:5px}.btn-outline{background:rgba(255,255,255,.62);color:#684d29}.btn-outline:hover{background:white}
  .edition-line{display:flex;align-items:center;gap:10px;margin-top:25px;color:#8c7655;font-family:Georgia,"Times New Roman",serif;font-size:.62rem;letter-spacing:.14em}.edition-line i{display:block;width:42px;height:1px;background:#c4aa7d}
  .stat-panel{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));min-height:280px;padding:48px 14px 22px;background:linear-gradient(135deg,#071d38,#0d3155);border:1px solid var(--gold2);box-shadow:inset 0 0 0 6px #0b294a,inset 0 0 0 7px rgba(209,173,106,.38),0 18px 42px rgba(7,29,56,.14);overflow:hidden}.stat-heading{position:absolute;top:18px;left:50%;transform:translateX(-50%);color:#d5b470;font-family:Georgia,serif;font-size:.68rem;letter-spacing:.28em;white-space:nowrap}.stat-heading:before,.stat-heading:after{content:"";position:absolute;top:50%;width:58px;height:1px;background:rgba(209,173,106,.45)}.stat-heading:before{right:calc(100% + 14px)}.stat-heading:after{left:calc(100% + 14px)}
