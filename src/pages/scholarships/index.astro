---
import BaseLayout from '../../layouts/BaseLayout.astro';

const modules = import.meta.glob('./items/*.md', { eager: true });
const scholarships = Object.values(modules)
  .map((mod: any) => ({ ...mod.frontmatter, url: mod.url }))
  .sort((a: any, b: any) => new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime());

const featured = scholarships.slice(0, 3);
const countries = [...new Set(scholarships.map((item: any) => item.country).filter(Boolean))].sort((a: any, b: any) => String(a).localeCompare(String(b), 'zh-Hant'));
const countryCount = countries.length;
const today = new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Taipei' }).format(new Date());
const description = '台灣國際獎學金雷達：從台灣學生角度整理全球大學、研究所、政府與基金會獎學金，每日查核並更新值得申請的機會。';

const flagMap: Record<string, string> = {
  '台灣': '🇹🇼', '英國': '🇬🇧', '美國': '🇺🇸', '加拿大': '🇨🇦', '澳洲': '🇦🇺', '紐西蘭': '🇳🇿',
  '日本': '🇯🇵', '韓國': '🇰🇷', '德國': '🇩🇪', '法國': '🇫🇷', '瑞士': '🇨🇭', '荷蘭': '🇳🇱',
  '瑞典': '🇸🇪', '芬蘭': '🇫🇮', '愛爾蘭': '🇮🇪', '比利時': '🇧🇪', '義大利': '🇮🇹', '新加坡': '🇸🇬',
  '香港': '🇭🇰', '歐盟': '🇪🇺', '德國／歐盟': '🇪🇺', '多國': '🌍', '全球': '🌍'
};
const flagFor = (country = '') => flagMap[country] ?? '🌐';
const statusClass = (status = '') => status.includes('開放中') ? 'open' : status.includes('即將') ? 'soon' : 'watch';
---
<BaseLayout title="台灣國際獎學金雷達｜100+ 全球獎學金資料庫" description={description}>
  <main class="scholarship-page">
    <section class="editorial-hero">
      <div class="ornament ornament-left" aria-hidden="true">⚜</div>
      <div class="ornament ornament-right" aria-hidden="true">⚜</div>
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="eyebrow">GLOBAL EDUCATION NEWS <span>✦</span> SCHOLARSHIP DESK</div>
          <h1>台灣國際獎學金雷達</h1>
          <p class="hero-subtitle">{scholarships.length}+ 全球獎學金資料庫 <span>｜</span> 每天更新 3 則</p>
          <p class="hero-description">從台灣學生的視角，整理全球獎學金、政府補助與國際大學資助機會。先確認官方來源、台灣資格與截止日，再把值得行動的資訊送到你面前。</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#all-opportunities"><span>⚜</span> 立即查看獎學金</a>
            <a class="btn btn-outline" href="#taiwan-programs">台灣政府計畫</a>
            <a class="btn btn-outline" href="#today-picks">今日 3 則</a>
          </div>
          <div class="edition-line"><span>TAIPEI</span><i></i><span>PARISIAN EDITORIAL EDITION</span><i></i><span>{today}</span></div>
        </div>

        <aside class="stat-panel" aria-label="獎學金雷達統計">
          <div class="stat-item"><span class="stat-icon">◎</span><strong>{scholarships.length}+</strong><small>全球機會</small></div>
          <div class="stat-item"><span class="stat-icon">⚑</span><strong>{countryCount}+</strong><small>國家與地區</small></div>
          <div class="stat-item"><span class="stat-icon">◷</span><strong>Daily 3</strong><small>每日更新</small></div>
          <div class="stat-item"><span class="stat-icon">◇</span><strong>Verified</strong><small>官方查核</small></div>
          <div class="panel-watermark" aria-hidden="true">PARIS</div>
        </aside>
      </div>
    </section>

    <section id="today-picks" class="editorial-section today-section">
      <div class="section-shell">
        <div class="section-title-row">
          <div>
            <div class="eyebrow dark">TODAY'S PICKS</div>
            <h2>今日精選</h2>
          </div>
          <div class="section-date">{today} · 每日查核</div>
        </div>

        <div class="spotlight-grid">
          {featured.map((item: any) => (
            <article class="spotlight-card">
              <div class="spotlight-top">
                <span class="country-line"><b>{flagFor(item.country)}</b>{item.country}</span>
                <span class:list={['status-pill', statusClass(item.status)]}>{item.status}</span>
              </div>
              <div class="spotlight-type">{item.category ?? item.sourceType}</div>
              <h3><a href={item.url}>{item.title}</a></h3>
              <p>{item.description}</p>
              <div class="spotlight-meta">
                <div><span>補助</span><strong>{item.funding}</strong></div>
                <div><span>學位</span><strong>{item.level}</strong></div>
                <div><span>截止</span><strong>{item.deadline}</strong></div>
              </div>
              <div class="spotlight-footer">
                <span class="tw-check">✓ 台灣學生：{item.eligibilityTW}</span>
                <a href={item.url}>查看申請重點 <span>→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="search-section" aria-label="獎學金搜尋與篩選">
      <div class="section-shell">
        <div class="search-panel">
          <label class="search-box">
            <span aria-hidden="true">⌕</span>
            <input id="scholarship-search" type="search" placeholder="搜尋獎學金、學校、國家或關鍵字…" autocomplete="off" />
          </label>
          <label class="select-box"><span>◎</span><select id="country-filter" aria-label="國家"><option value="all">國家</option>{countries.map((country: any) => <option value={country}>{country}</option>)}</select></label>
          <label class="select-box"><span>🎓</span><select id="level-filter" aria-label="學位"><option value="all">學位</option><option value="大學">大學</option><option value="學士">學士</option><option value="碩士">碩士</option><option value="博士">博士</option><option value="研究">研究</option></select></label>
          <label class="select-box"><span>◇</span><select id="funding-filter" aria-label="補助類型"><option value="all">補助類型</option><option value="全額">全額</option><option value="學費">學費</option><option value="生活">生活費</option><option value="部分">部分補助</option></select></label>
          <label class="select-box"><span>♢</span><select id="status-filter" aria-label="狀態"><option value="all">狀態</option><option value="開放中">開放中</option><option value="即將開放">即將開放</option><option value="下一輪">下一輪追蹤</option><option value="年度">年度制</option></select></label>
          <button id="clear-filters" class="clear-btn" type="button">↻ 清除篩選</button>
        </div>
      </div>
    </section>

    <section id="taiwan-programs" class="taiwan-programs">
      <div class="taiwan-watermark left" aria-hidden="true">TO THE WORLD</div>
      <div class="taiwan-watermark right" aria-hidden="true">TAIWAN</div>
      <div class="section-shell">
        <div class="center-heading">
          <div class="french-kicker">From Taiwan to the World</div>
          <h2>台灣學生不可錯過的官方補助</h2>
          <p>從教育部學海系列到公費留學與青年海外圓夢，把台灣本地可用的國際資源一起納入規劃。</p>
        </div>
        <div class="program-pills">
          <a href="https://www.studyabroad.moe.gov.tw/new/index.php/" target="_blank" rel="noopener noreferrer"><span>✈</span>學海飛颺</a>
          <a href="https://www.studyabroad.moe.gov.tw/new/index.php/" target="_blank" rel="noopener noreferrer"><span>◇</span>學海惜珠</a>
          <a href="https://www.studyabroad.moe.gov.tw/new/index.php/" target="_blank" rel="noopener noreferrer"><span>◎</span>學海築夢</a>
          <a href="https://www.studyabroad.moe.gov.tw/new/index.php/" target="_blank" rel="noopener noreferrer"><span>✦</span>新南向學海築夢</a>
          <a href="https://twpathfinder.yda.gov.tw/" target="_blank" rel="noopener noreferrer"><span>↗</span>青年百億海外圓夢</a>
          <a href="https://www.scholarship.moe.gov.tw/scholarship" target="_blank" rel="noopener noreferrer"><span>🎓</span>留學獎學金</a>
          <a href="https://www.scholarship.moe.gov.tw/exam-v2/student/login" target="_blank" rel="noopener noreferrer"><span>▤</span>公費留學</a>
        </div>
      </div>
    </section>

    <section id="all-opportunities" class="editorial-section catalog-section">
      <div class="section-shell">
        <div class="catalog-heading">
          <div>
            <div class="eyebrow dark">EXPLORE THE ARCHIVE</div>
            <h2>探索全部獎學金</h2>
            <p>Scholarships · Fellowships · Grants · Global Opportunities</p>
          </div>
          <div class="result-summary"><strong id="result-count">{scholarships.length}</strong><span>個符合條件的機會</span></div>
        </div>

        <div class="catalog-grid" id="catalog-grid">
          {scholarships.map((item: any, index: number) => {
            const searchText = [item.title, item.description, item.country, item.level, item.funding, item.status, item.sourceType, item.category].filter(Boolean).join(' ').toLowerCase();
            return (
              <article
                class="catalog-card"
                data-card
                data-index={index}
                data-search={searchText}
                data-country={item.country ?? ''}
                data-level={item.level ?? ''}
                data-funding={item.funding ?? ''}
                data-status={item.status ?? ''}
              >
                <div class="catalog-top">
                  <span class="country-line"><b>{flagFor(item.country)}</b>{item.country}</span>
                  <span class:list={['status-dot', statusClass(item.status)]}>{item.status}</span>
                </div>
                <h3><a href={item.url}>{item.title}</a></h3>
                <div class="catalog-tags"><span>{item.level}</span><span>{item.sourceType}</span></div>
                <dl>
                  <div><dt>補助</dt><dd>{item.funding}</dd></div>
                  <div><dt>截止</dt><dd>{item.deadline}</dd></div>
                </dl>
                <div class="catalog-bottom"><span>✓ 台灣資格已查核</span><a href={item.url}>詳情 →</a></div>
              </article>
            );
          })}
        </div>

        <div class="load-row"><button id="load-more" type="button">顯示更多獎學金 <span>＋</span></button></div>
      </div>
    </section>

    <section class="verification-section">
      <div class="section-shell verification-grid">
        <div>
          <div class="eyebrow">EDITORIAL STANDARD</div>
          <h2>獎學金資訊，也需要新聞編輯室的查核標準。</h2>
        </div>
        <div class="verification-steps">
          <div><span>01</span><p><strong>官方原始來源</strong><br />政府、大學、基金會或主辦單位。</p></div>
          <div><span>02</span><p><strong>第二來源交叉確認</strong><br />FAQ、招生頁、官方窗口或可靠來源。</p></div>
          <div><span>03</span><p><strong>台灣資格確認</strong><br />國籍、居住地、學位與申請方式。</p></div>
          <div><span>04</span><p><strong>截止日持續追蹤</strong><br />開放、延期、截止與下一年度更新。</p></div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const cards = Array.from(document.querySelectorAll('[data-card]'));
      const search = document.getElementById('scholarship-search');
      const country = document.getElementById('country-filter');
      const level = document.getElementById('level-filter');
      const funding = document.getElementById('funding-filter');
      const status = document.getElementById('status-filter');
      const clear = document.getElementById('clear-filters');
      const loadMore = document.getElementById('load-more');
      const count = document.getElementById('result-count');
      let limit = 24;

      const valueOf = (el) => (el && 'value' in el ? String(el.value) : 'all');
      const apply = () => {
        const q = valueOf(search).trim().toLowerCase();
        const countryValue = valueOf(country);
        const levelValue = valueOf(level);
        const fundingValue = valueOf(funding);
        const statusValue = valueOf(status);
        const matches = cards.filter((card) => {
          const text = (card.dataset.search || '');
          const okSearch = !q || text.includes(q);
          const okCountry = countryValue === 'all' || card.dataset.country === countryValue;
          const okLevel = levelValue === 'all' || (card.dataset.level || '').includes(levelValue);
          const okFunding = fundingValue === 'all' || (card.dataset.funding || '').includes(fundingValue);
          const okStatus = statusValue === 'all' || (card.dataset.status || '').includes(statusValue);
          return okSearch && okCountry && okLevel && okFunding && okStatus;
        });
        cards.forEach((card) => { card.hidden = true; });
        matches.slice(0, limit).forEach((card) => { card.hidden = false; });
        if (count) count.textContent = String(matches.length);
        if (loadMore) loadMore.hidden = matches.length <= limit;
      };

      [search, country, level, funding, status].forEach((el) => {
        el?.addEventListener(el === search ? 'input' : 'change', () => { limit = 24; apply(); });
      });
      clear?.addEventListener('click', () => {
        if (search) search.value = '';
        [country, level, funding, status].forEach((el) => { if (el) el.value = 'all'; });
        limit = 24;
        apply();
      });
      loadMore?.addEventListener('click', () => { limit += 24; apply(); });
      apply();
    })();
  </script>
</BaseLayout>

<style>
  :global(html){scroll-behavior:smooth}
  .scholarship-page{--ink:#102a4c;--navy:#071f3d;--navy2:#0d3159;--gold:#b98a45;--gold2:#d5b06f;--ivory:#fbf8f1;--paper:#f6f0e5;--burgundy:#7d1f2d;--green:#2f7b4f;--line:#ded2bc;background:var(--ivory);color:#1b2b42;font-family:"Noto Serif TC",Georgia,"Times New Roman",serif}
  .section-shell,.hero-inner{width:min(1280px,calc(100% - 40px));margin:0 auto}
  .editorial-hero{position:relative;overflow:hidden;padding:58px 0 52px;background:radial-gradient(circle at 15% 20%,rgba(185,138,69,.09),transparent 22%),linear-gradient(180deg,#fffdf8 0%,#f7f0e4 100%);border-top:1px solid #d9c8a9;border-bottom:1px solid #d9c8a9}
  .editorial-hero:before,.editorial-hero:after{content:"";position:absolute;inset:12px;border:1px solid rgba(185,138,69,.22);pointer-events:none}.editorial-hero:after{inset:18px;border-color:rgba(185,138,69,.08)}
  .ornament{position:absolute;top:16px;color:var(--gold);font-size:1.2rem;z-index:2}.ornament-left{left:24px}.ornament-right{right:24px;transform:scaleX(-1)}
  .hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:1.08fr .92fr;gap:46px;align-items:center}
  .eyebrow{font-family:Arial,"Noto Sans TC",sans-serif;font-size:.72rem;letter-spacing:.19em;font-weight:800;color:var(--gold);text-transform:uppercase}.eyebrow span{padding:0 7px}.eyebrow.dark{color:#8d6a34}
  .hero-copy h1{margin:13px 0 10px;color:var(--ink);font-size:clamp(2.65rem,5.1vw,5rem);font-weight:700;letter-spacing:.035em;line-height:1.08;text-wrap:balance}
  .hero-subtitle{margin:0;color:var(--burgundy);font-size:clamp(1.05rem,2vw,1.45rem);font-weight:700;letter-spacing:.04em}.hero-subtitle span{color:#b39462;padding:0 6px}
  .hero-description{max-width:690px;margin:18px 0 0;color:#54514b;font-size:1rem;line-height:1.9}
  .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:25px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 19px;border:1px solid #cbaa71;text-decoration:none;font-family:Arial,"Noto Sans TC",sans-serif;font-size:.84rem;font-weight:800;letter-spacing:.04em;transition:.2s ease}.btn-primary{background:var(--burgundy);border-color:var(--burgundy);color:white;box-shadow:0 6px 18px rgba(86,25,33,.14)}.btn-primary:hover{background:#651923}.btn-outline{background:rgba(255,255,255,.45);color:#6a4b20}.btn-outline:hover{background:white}
  .edition-line{display:flex;align-items:center;gap:10px;margin-top:24px;color:#927954;font-family:Arial,"Noto Sans TC",sans-serif;font-size:.62rem;letter-spacing:.13em}.edition-line i{display:block;width:34px;height:1px;background:#c7ae83}
  .stat-panel{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));min-height:250px;padding:24px 14px;background:linear-gradient(135deg,#081f3b,#0c3159);border:1px solid var(--gold2);box-shadow:inset 0 0 0 6px #0b294d,inset 0 0 0 7px rgba(213,176,111,.35),0 18px 40px rgba(7,31,61,.12);overflow:hidden}.stat-panel:before,.stat-panel:after{content:"✦";position:absolute;color:var(--gold2);font-size:.65rem;top:12px}.stat-panel:before{left:14px}.stat-panel:after{right:14px}
  .stat-item{position:relative;z-index:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:12px 8px;border-right:1px dotted rgba(213,176,111,.55)}.stat-item:last-of-type{border-right:0}.stat-icon{color:var(--gold2);font-size:1.7rem}.stat-item strong{display:block;max-width:100%;margin:10px 0 5px;color:#ddb66f;font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.45rem,2vw,2.4rem);font-weight:500;line-height:1.05;letter-spacing:-.02em;white-space:nowrap}.stat-item small{color:#f2eadf;font-size:.82rem;letter-spacing:.04em;white-space:nowrap}.panel-watermark{position:absolute;right:-8px;bottom:-16px;color:rgba(255,255,255,.035);font-family:Georgia,serif;font-size:5rem;letter-spacing:.08em;transform:rotate(-90deg);transform-origin:bottom right}
  .editorial-section{padding:50px 0}.today-section{background:#fffdf9}.section-title-row,.catalog-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:23px;padding-bottom:13px;border-bottom:1px solid #d8c7a9;position:relative}.section-title-row:after,.catalog-heading:after{content:"⚜";position:absolute;left:0;bottom:-10px;padding-right:8px;background:#fffdf9;color:var(--gold);font-size:.8rem}.section-title-row h2,.catalog-heading h2,.center-heading h2,.verification-grid h2{margin:5px 0 0;color:var(--ink);font-size:clamp(1.8rem,3vw,2.7rem);font-weight:700;letter-spacing:.04em}.section-date{color:#8a7961;font-family:Arial,"Noto Sans TC",sans-serif;font-size:.75rem;letter-spacing:.05em}
  .spotlight-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.spotlight-card{position:relative;overflow:hidden;padding:22px 22px 18px;background:linear-gradient(180deg,#fff 0%,#fbf7ef 100%);border:1px solid #d9cdb9;box-shadow:0 9px 26px rgba(47,44,36,.05)}.spotlight-card:after{content:"";position:absolute;left:-35px;bottom:-45px;width:150px;height:110px;border:1px solid rgba(17,43,75,.06);border-radius:50%;box-shadow:20px -12px 0 rgba(17,43,75,.02);transform:rotate(-12deg)}
