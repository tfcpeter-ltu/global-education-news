---
import BaseLayout from '../../layouts/BaseLayout.astro';
const modules = import.meta.glob('../news/*.md', { eager: true });
const stories = Object.entries(modules).map(([path, mod]: [string, any]) => ({ ...mod.frontmatter, slug: path.replace('../news/', '').replace('.md', '') })).filter((s:any) => /英國|UK|United Kingdom|Student visa|Graduate visa|Child Student/i.test(`${s.title ?? ''} ${s.description ?? ''} ${s.topic ?? ''}`)).sort((a:any,b:any)=>new Date(b.date??0).getTime()-new Date(a.date??0).getTime()).slice(0,12);
const origin = Astro.site ?? Astro.url.origin; const canonical = new URL(Astro.url.pathname, origin).toString();
const ld={'@context':'https://schema.org','@type':'CollectionPage',name:'英國留學政策中心｜Global Education News',description:'追蹤英國 Student visa、Graduate visa、Child Student、大學招生與國際學生政策。',url:canonical,inLanguage:'zh-Hant-TW',about:[{'@type':'Thing',name:'UK international student policy'},{'@type':'Thing',name:'Student visa'},{'@type':'Thing',name:'Graduate visa'}]};
---
<BaseLayout title="英國留學政策中心｜Student Visa、Graduate Visa、大學招生" description="追蹤英國 Student visa、Graduate visa、Child Student、大學招生與國際學生制度的最新政策。"><Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(ld)}></script></Fragment><section class="page"><div class="page-shell"><div class="kicker">UK POLICY WATCH</div><h1>英國留學政策中心</h1><p>集中追蹤英國國際學生政策，包括 Student visa、Graduate visa、Child Student、CAS、國際學生招生與高等教育制度。本站優先核對 GOV.UK、Home Office、UKVI、大學及其他第一手資料。</p><h2>查核重點</h2><p>簽證新聞會區分 Immigration Rules 正式規定、Home Office guidance、政府政策宣布及媒體報導，並核對生效日期、適用對象與例外條款。</p><h2>最新英國政策新聞</h2>{stories.length ? <ul>{stories.map((s:any)=><li><a href={`/news/${s.slug}/`}>{s.title}</a></li>)}</ul> : <p>最新英國政策報導整理中。</p>}<p><a href="/intelligence/international-student-policy/">← 全球國際學生政策中心</a></p></div></section></BaseLayout>