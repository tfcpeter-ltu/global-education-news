---
import IntelligenceLayout from '../../../layouts/IntelligenceLayout.astro';

const modules = import.meta.glob('../../news/*.md', { eager: true });
const articles = Object.values(modules)
  .map((mod: any) => ({ ...mod.frontmatter, url: mod.url }))
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());

const policyKeywords = /政策|簽證|visa|permit|移民|工作權|international student|財力|cap|CPT|PGWP|study permit|graduate route/i;
const signals = articles
  .filter((story: any) => story.topic !== 'taiwan')
  .filter((story: any) => policyKeywords.test(`${story.title} ${story.category} ${story.description}`));
---
<IntelligenceLayout
  title="Policy Radar｜全球教育政策雷達｜GEI"
  description="GEI Policy Radar 追蹤各國學生簽證、國際學生政策、工作權、教育制度與跨境流動規則，優先連結政府與主管機關一手來源。"
  heading="Policy Radar"
  deck="全球教育政策雷達。把分散在各國政府、移民主管機關與教育體系中的政策變化，整理成可持續追蹤的教育情報。"
>
  <div class="container radar-body">
    <section class="radar-intro">
      <div>
        <div class="intel-kicker">LIVE BETA · PHASE 1</div>
        <h2>先從已查證新聞建立政策訊號層</h2>
      </div>
      <p>第一階段由 Global Education News 現有的一手來源新聞自動彙整。下一階段將加入「舊規定 → 新規定 → 生效日期 → 影響對象 → 版本紀錄」的結構化變更資料。</p>
    </section>

    <section class="radar-dashboard">
      <div class="radar-stat"><strong>{signals.length}</strong><span>目前可追蹤政策訊號</span></div>
      <div class="radar-stat"><strong>Official-first</strong><span>優先採官方一手來源</span></div>
      <div class="radar-stat"><strong>Change log</strong><span>下一階段加入歷史版本</span></div>
    </section>

    <section class="radar-section">
      <div class="section-heading-line">
        <div><div class="intel-kicker">POLICY SIGNALS</div><h2>最新政策訊號</h2></div>
        <span>依發布日期排序</span>
      </div>

      <div class="signal-list">
        {signals.length > 0 ? signals.map((story: any) => {
          const source = Array.isArray(story.sources) ? story.sources[0] : null;
          return (
            <article class="policy-card">
              <div class="policy-date">
                <strong>{new Intl.DateTimeFormat('zh-TW', { month: '2-digit', day: '2-digit' }).format(new Date(story.date))}</strong>
                <span>{new Intl.DateTimeFormat('zh-TW', { year: 'numeric' }).format(new Date(story.date))}</span>
              </div>
              <div class="policy-copy">
                <div class="policy-meta">{story.category}</div>
                <h3><a href={story.url}>{story.title}</a></h3>
                <p>{story.description}</p>
                <div class="policy-links">
                  <a href={story.url}>完整分析 →</a>
                  {source?.url && <a href={source.url} target="_blank" rel="noopener noreferrer">官方來源 ↗</a>}
                </div>
              </div>
              <div class="policy-status">VERIFIED SIGNAL</div>
            </article>
          );
        }) : <div class="empty-state">目前尚無政策訊號。</div>}
      </div>
    </section>

    <section class="next-layer">
      <div class="intel-kicker">NEXT DATA LAYER</div>
      <h2>正式版本會多出哪些欄位？</h2>
      <div class="field-grid">
        <div><strong>Before</strong><span>變更前規定</span></div>
        <div><strong>After</strong><span>變更後規定</span></div>
        <div><strong>Effective</strong><span>生效日期</span></div>
        <div><strong>Audience</strong><span>受影響學生</span></div>
        <div><strong>Impact</strong><span>影響程度</span></div>
        <div><strong>Source</strong><span>官方原始文件</span></div>
      </div>
    </section>
  </div>
</IntelligenceLayout>

<style>
  .radar-body { padding-bottom: 68px; }
  .intel-kicker { font-family: Arial, "Noto Sans TC", sans-serif; font-size: .66rem; font-weight: 900; letter-spacing: .15em; color: var(--burgundy); }
  .radar-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 38px; align-items: end; padding: 36px 0 26px; border-bottom: 3px double var(--line-dark); }
  .radar-intro h2 { margin: 5px 0 0; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.1; }
  .radar-intro p { margin: 0; color: var(--muted); }
  .radar-dashboard { display: grid; grid-template-columns: repeat(3, 1fr); border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .radar-stat { min-height: 104px; padding: 21px 20px; border-right: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; }
  .radar-stat strong { font-size: 1.35rem; color: #172235; }
  .radar-stat span { font-family: Arial, "Noto Sans TC", sans-serif; font-size: .7rem; color: var(--muted); }
  .radar-section { padding-top: 39px; }
  .section-heading-line { display: flex; justify-content: space-between; align-items: end; gap: 24px; padding-bottom: 12px; border-bottom: 3px double var(--line-dark); }
  .section-heading-line h2 { margin: 4px 0 0; font-size: 2rem; }
  .section-heading-line > span { font-family: Arial, sans-serif; font-size: .68rem; color: var(--muted); }
  .policy-card { display: grid; grid-template-columns: 76px minmax(0, 1fr) 110px; gap: 22px; padding: 23px 0; border-bottom: 1px solid var(--line); }
  .policy-date { border-right: 1px solid var(--line); display: flex; flex-direction: column; }
  .policy-date strong { font-family: Georgia, serif; font-size: 1.45rem; line-height: 1; }
  .policy-date span { margin-top: 5px; font-family: Arial, sans-serif; font-size: .65rem; color: var(--muted); }
  .policy-meta { font-family: Arial, "Noto Sans TC", sans-serif; font-size: .67rem; font-weight: 800; color: var(--burgundy); }
  .policy-copy h3 { margin: 5px 0 7px; font-size: 1.38rem; line-height: 1.28; }
  .policy-copy p { margin: 0; color: #5c574f; font-size: .92rem; }
  .policy-links { display: flex; gap: 18px; margin-top: 11px; font-family: Arial, "Noto Sans TC", sans-serif; font-size: .69rem; font-weight: 800; }
  .policy-links a { color: var(--burgundy); }
  .policy-status { align-self: start; justify-self: end; padding: 5px 7px; border: 1px solid #8c938d; font-family: Arial, sans-serif; font-size: .55rem; font-weight: 900; letter-spacing: .06em; color: #49604e; }
  .next-layer { margin-top: 45px; padding-top: 28px; border-top: 3px double var(--line-dark); }
  .next-layer h2 { margin: 5px 0 18px; font-size: 1.75rem; }
  .field-grid { display: grid; grid-template-columns: repeat(6, 1fr); border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .field-grid > div { min-height: 92px; padding: 17px 13px; border-right: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; }
  .field-grid strong { font-family: Arial, sans-serif; font-size: .72rem; color: #172235; }
  .field-grid span { font-size: .78rem; color: var(--muted); }
  .empty-state { padding: 30px 0; color: var(--muted); }
  @media (max-width: 820px) {
    .radar-intro { grid-template-columns: 1fr; gap: 12px; }
    .policy-card { grid-template-columns: 58px 1fr; }
    .policy-status { grid-column: 2; justify-self: start; }
    .field-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 560px) {
    .radar-dashboard { grid-template-columns: 1fr; }
    .policy-card { grid-template-columns: 1fr; gap: 10px; }
    .policy-date { border-right: 0; flex-direction: row; gap: 8px; align-items: baseline; }
    .policy-status { grid-column: auto; }
    .field-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
