---
import BaseLayout from '../../layouts/BaseLayout.astro';
const modules=import.meta.glob('../news/*.md',{eager:true}); const stories=Object.entries(modules).map(([path,mod]:[string,any])=>({...mod.frontmatter,slug:path.replace('../news/','').replace('.md','')})).filter((s:any)=>/美國|United States|F-1|OPT|CPT|SEVP|USCIS|DHS/i.test(`${s.title??''} ${s.description??''} ${s.topic??''}`)).sort((a:any,b:any)=>new Date(b.date??0).getTime()-new Date(a.date??0).getTime()).slice(0,12); const origin=Astro.site??Astro.url.origin; const canonical=new URL(Astro.url.pathname,origin).toString(); const ld={'@context':'https://schema.org','@type':'CollectionPage',name:'美國國際學生政策中心｜Global Education News',description:'追蹤美國 F-1、OPT、CPT、SEVP、學生簽證與大學國際招生政策。',url:canonical,inLanguage:'zh-Hant-TW',about:[{'@type':'Thing',name:'F-1 visa'},{'@type':'Thing',name:'Optional Practical Training'},{'@type':'Thing',name:'SEVP'}]};
---
<BaseLayout title="美國國際學生政策中心｜F-1、OPT、CPT、SEVP 最新政策" description="追蹤美國 F-1、OPT、CPT、SEVP、學生簽證與大學國際招生政策。"><Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(ld)}></script></Fragment><section class="page"><div class="page-shell"><div class="kicker">U.S. POLICY WATCH</div><h1>美國國際學生政策中心</h1><p>集中追蹤美國 F-1 學生身分、OPT、CPT、SEVP、學生簽證及大學國際招生制度。政策新聞優先回查 DHS、USCIS、Department of State、Federal Register、法院文件及大學官方資訊。</p><h2>查核重點</h2><p>本站會區分行政規則、最終規則、法院判決、政府指引與學校執行措施，避免將提案或媒體解讀寫成已生效政策。</p><h2>最新美國政策新聞</h2>{stories.length?<ul>{stories.map((s:any)=><li><a href={`/news/${s.slug}/`}>{s.title}</a></li>)}</ul>:<p>最新美國政策報導整理中。</p>}<p><a href="/intelligence/international-student-policy/">← 全球國際學生政策中心</a></p></div></section></BaseLayout>