---
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const link = (path = '') => `${base}${path}`;

const modules = import.meta.glob('./news/*.md', { eager: true });
const articles = Object.values(modules)
  .map((mod: any) => ({ ...mod.frontmatter, url: mod.url }))
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());

const storyImage = (story: any) => {
  const images: Record<string, string> = {
    australia: link('images/australia.svg'),
    canada: link('images/canada.svg'),
    uk: link('images/uk.svg'),
    us: link('images/us.svg'),
    admissions: link('images/peter-lecture.svg')
  };
  return story.image ?? images[story.topic] ?? images.admissions;
};

const lead = articles[0];
const side = articles.slice(1, 3);
const latest = articles.slice(0, 6);
---
<BaseLayout>
  <div class="container">
    {lead ? (
      <section class="hero visual-hero">
        <div class="hero-main">
          <a class="hero-photo" href={lead.url} aria-label={lead.title}>
            <img src={storyImage(lead)} alt={`${lead.category}新聞主圖`} loading="eager" />
            <span class="photo-label">TOP STORY</span>
          </a>
          <div class="kicker">TOP STORY · {lead.category}</div>
          <h1><a href={lead.url}>{lead.title}</a></h1>
          <p class="hero-deck">{lead.description}</p>
          <div class="hero-meta">
            <span>{lead.author ?? 'Global Education News 編輯部'}</span>
            <span>{new Intl.DateTimeFormat('zh-TW').format(new Date(lead.date))}</span>
          </div>
        </div>
        <div class="hero-side">
          <div class="kicker">LATEST</div>
          {side.map((story: any) => (
            <article class="side-story side-story-visual">
              <a class="side-thumb" href={story.url}><img src={storyImage(story)} alt={`${story.category}新聞圖片`} loading="lazy" /></a>
              <div>
                <h2><a href={story.url}>{story.title}</a></h2>
                <p class="muted">{story.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    ) : (
      <section class="hero">
        <div class="hero-main">
          <div class="kicker">GLOBAL EDUCATION NEWS</div>
          <h1>從政策到校園，理解國際教育正在發生的變化。</h1>
          <p class="hero-deck">本站正在建立第一批原創新聞與深度文章。內容將優先引用政府、大學與第一手公開資料。</p>
        </div>
      </section>
    )}

    <section class="section">
      <div class="section-heading">
        <h2>最新新聞</h2>
        <span class="muted">International Education · Policy · Admissions</span>
      </div>
      <div class="grid-3">
        {latest.map((story: any) => (
          <article class="card story-card">
            <a class="card-image" href={story.url}><img src={storyImage(story)} alt={`${story.category}新聞圖片`} loading="lazy" /></a>
            <div class="card-content">
              <div class="kicker">{story.category}</div>
              <h3><a href={story.url}>{story.title}</a></h3>
              <p>{story.description}</p>
              <div class="card-meta">{new Intl.DateTimeFormat('zh-TW').format(new Date(story.date))}</div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section peter-feature">
      <div class="peter-feature-image">
        <img src={link('images/peter-lecture.svg')} alt="Peter的國際教育講座" loading="lazy" />
      </div>
      <div class="peter-feature-copy">
        <div class="kicker">PETER'S COLUMN · EDUCATION INSIGHT</div>
        <h2>Peter的國際教育講座</h2>
        <p class="peter-lead">從全球大學、留學政策、國際高中到升學制度，把新聞背後的制度與選擇說給學生、家長與教育工作者聽。</p>
        <p>這個專區會整理 Peter 過去在 Facebook 發表的國際教育文章，重新查證資料、補充來源與更新時效後，轉化成可以長期搜尋與引用的深度內容。</p>
        <div class="feature-actions">
          <a class="button button-primary" href={link('peter/')}>進入 Peter的國際教育講座</a>
          <a class="button button-facebook" href="https://www.facebook.com/peterlecture/" target="_blank" rel="noopener noreferrer">Facebook 粉絲專頁 ↗</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-heading"><h2>我們關注什麼</h2></div>
      <div class="grid-3 topic-grid">
        <a class="topic-card" href={link('topics/policy/')}>
          <span class="topic-icon">政策</span><div><div class="kicker">POLICY</div><h3>留學與移民政策</h3><p>追蹤學生簽證、工作權、國際學生政策與各國教育制度變動。</p></div>
        </a>
        <a class="topic-card" href={link('topics/admissions/')}>
          <span class="topic-icon">大學</span><div><div class="kicker">UNIVERSITIES</div><h3>全球大學與招生</h3><p>招生規則、科系趨勢、錄取制度、學費與國際學生數據。</p></div>
        </a>
        <a class="topic-card" href={link('insight/')}>
          <span class="topic-icon">深度</span><div><div class="kicker">INSIGHT</div><h3>深度專題與觀點</h3><p>以資料與第一手來源，把新聞轉化成台灣學生與家長可以使用的判斷。</p></div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
