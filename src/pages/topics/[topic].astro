---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CampusHub from '../../components/CampusHub.astro';
import { getStoryImageInfo } from '../../lib/storyImages';

export function getStaticPaths() {
  const topics: Record<string, { label: string; description: string }> = {
    taiwan: { label: '台灣校園國際新聞', description: '追蹤台灣高中與大學的國際教育新聞，查找學校國際交流入口、海外升學、交換、雙聯學位與獎學金準備指南。' },
    us: { label: '美國', description: '美國大學、國際學生、簽證、實習與招生政策。' },
    canada: { label: '加拿大', description: '加拿大國際教育、學簽、大學與學生政策。' },
    uk: { label: '英國', description: '英國大學、學生簽證、招生與高等教育政策。' },
    australia: { label: '澳洲', description: '澳洲國際學生、大學招生與教育政策。' },
    asia: { label: '亞洲', description: '香港、日本、新加坡與亞洲主要教育市場。' },
    admissions: { label: '大學招生', description: '全球大學申請、錄取制度、科系與招生趨勢。' },
    policy: { label: '留學政策', description: '學生簽證、工作權、移民與國際教育制度變動。' }
  };

  return Object.entries(topics).map(([topic, data]) => ({ params: { topic }, props: { data, topic } }));
}

const { data, topic } = Astro.props;
const modules = import.meta.glob('../news/*.md', { eager: true });
let articles = Object.values(modules)
  .map((mod: any) => ({ ...mod.frontmatter, url: mod.url }))
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime());

articles = articles.filter((story: any) => {
  const tags = Array.isArray(story.tags) ? story.tags : [];
  if (story.topic === topic || tags.includes(topic)) return true;
  if (topic === 'policy' && String(story.category ?? '').includes('政策')) return true;
  return false;
});
---
<BaseLayout title={topic === 'taiwan' ? '台灣校園國際新聞｜Global Education News' : `${data.label}國際教育新聞｜Global Education News`} description={data.description}>
  <section class="page">
    <div class="container">
      <div class="kicker">TOPIC</div>
      <h1>{data.label}</h1>
      <p class="hero-deck">{data.description}</p>
      {topic === 'taiwan' && <nav class="taiwan-sections" aria-label="專區內容"><a href="#taiwan-news">最新校園新聞 ↓</a><a href="/campus/reports/">校園出國特別報導 →</a><a href="#campus">校園國際機會 ↓</a><a href="#schools">找學校 ↓</a><a href="#guides">出國準備指南 ↓</a></nav>}
      <hr class="rule" />
      {topic === 'taiwan' && <h2 id="taiwan-news">最新台灣校園新聞</h2>}
      {articles.length > 0 ? (
        <div class="grid-3">
          {articles.map((story: any) => {
            const photo = getStoryImageInfo(story);
            return (
              <article class="card story-card">
                <a class="card-image" href={story.url}><img src={photo.url} alt={photo.alt} loading="lazy" referrerpolicy="no-referrer" /></a>
                <div class="card-content">
                  <div class="kicker">{story.category}</div>
                  <h3><a href={story.url}>{story.title}</a></h3>
                  <p>{story.description}</p>
                  <div class="card-meta">{new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei' }).format(new Date(story.date))}</div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <p class="muted">這個專區的第一批文章正在整理中。</p>
      )}
    </div>
  </section>
  {topic === 'taiwan' && <CampusHub />}
</BaseLayout>
<style>
.taiwan-sections{display:flex;flex-wrap:wrap;gap:12px;margin:24px 0}.taiwan-sections a{padding:12px 18px;border:1px solid var(--line-dark);color:var(--burgundy);font-weight:700}.taiwan-sections a:focus-visible{outline:2px solid var(--burgundy);outline-offset:3px}#taiwan-news{margin:24px 0}html{scroll-padding-top:80px}
</style>
