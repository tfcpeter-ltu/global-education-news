---
const { video: v } = Astro.props;
const duration = (value: string) => { const [,h='0',m='0',s='0']=value.match(/^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/)??[]; return Number(h)?`${h}:${m.padStart(2,'0')}:${s.padStart(2,'0')}`:`${Number(m)}:${s.padStart(2,'0')}`; };
const sourceLabel = (type: string) => type === 'official' ? '大學官方' : type === 'submission' ? '讀者投稿' : 'Peter 精選';
---
<article class="video-card" data-id={v.id} data-url={v.url} data-source={v.sourceType} data-recommended={v.recommended ? 'true' : 'false'} data-featured={v.featured ? 'true' : 'false'} data-format={v.format ?? 'video'}>
  <button class="card-play" type="button" aria-label={v.title}>
    <div class="card-cover"><img src={v.thumbnail} alt={v.title} width="640" height="360" loading="lazy" /><span class="card-play-icon" aria-hidden="true">▶</span>{v.format === 'short' && <span class="short-label">SHORTS</span>}<span class="duration">{duration(v.duration)}</span></div>
    <h3>{v.title}</h3>
  </button>
  <div class="card-details"><p class="channel-name">{v.channelTitle}</p><p class="card-meta"><span>{v.recommended ? 'Peter 推薦' : sourceLabel(v.sourceType)}</span><span aria-hidden="true"> · </span><time datetime={v.publishedAt}>{v.publishedAt.slice(0,10)}</time></p></div>
  <p class="card-description">{v.description}</p><span class="country" hidden>{v.country}</span><span class="topic" hidden>{v.topic}</span>
</article>
<style>
.video-card{min-width:0;scroll-margin-top:110px}.card-play{display:block;padding:0;border:0;background:none;text-align:left;width:100%;color:inherit;cursor:pointer}.card-cover{position:relative;aspect-ratio:16/9;border-radius:11px;overflow:hidden;background:#0b263b}.card-cover img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .2s}.card-play:hover img{transform:scale(1.035)}.card-play h3{font-size:15px;line-height:1.5;margin:11px 0 5px;font-weight:700;color:#17384f}.duration{position:absolute;bottom:7px;right:7px;background:#001729db;color:white;font-size:11px;font-weight:700;border-radius:4px;padding:2px 5px}.short-label{position:absolute;top:8px;left:8px;background:#075b9be8;color:#fff;padding:3px 6px;border-radius:4px;font-size:9px;letter-spacing:.08em;font-weight:700}.card-play-icon{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:45px;height:32px;display:grid;place-items:center;border-radius:8px;background:#075b9bdf;color:white;opacity:0}.card-play:hover .card-play-icon,.card-play:focus-visible .card-play-icon{opacity:1}.channel-name,.card-meta{font-size:11px;color:#647889;line-height:1.6;margin:0}.card-description{font-size:12px;line-height:1.65;color:#526575;margin:8px 0 0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.is-playing .card-cover{outline:3px solid #0877b8;outline-offset:3px}.video-card[data-format="short"] .card-cover{aspect-ratio:9/13;max-height:320px}.video-card[data-format="short"] img{object-fit:cover}@media(prefers-reduced-motion:reduce){.card-cover img{transition:none}}
</style>
