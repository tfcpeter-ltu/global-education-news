---
interface Props { placement: string; format?: 'banner' | 'card'; }
const { placement, format = 'banner' } = Astro.props;
const inquiry = '/advertise/';
const labels: Record<string, string> = {
  H1: '首頁頭條後', N1: '新聞列表', N2: '新聞列表後', N4: '文章閱讀後',
  S1: '獎學金精選區後', S2: '獎學金資料庫後',
  U1: '台灣大學選校', U2: '台灣大學資料庫後',
  P1: 'Peter 專欄精選區後', P2: 'Peter 文章列表後'
};
const description = labels[placement] ?? '國際教育';
const isRoyalCrownHomeBanner = placement === 'H1';
---
{isRoyalCrownHomeBanner ? (
  <aside class="ad-placement royal-crown-banner" aria-label="廣告：Royal Crown School 加拿大皇冠高中" data-ad-placement={placement}>
    <div class="ad-placement-label">ADVERTISEMENT · 廣告</div>
    <a class="royal-crown-banner-link" href="https://www.ossdtw.com/" target="_blank" rel="sponsored noopener" aria-label="前往 Royal Crown School 加拿大皇冠高中台灣資訊網站">
      <img src="/ads/images/royal-crown-school-home-banner.webp" width="1500" height="750" alt="" loading="lazy" decoding="async" />
      <span class="royal-crown-banner-copy">
        <span class="royal-crown-banner-eyebrow">加拿大多倫多・安大略省高中</span>
        <strong>ROYAL CROWN SCHOOL</strong>
        <span class="royal-crown-banner-feature">OSSD 國際升學・個人化支持</span>
        <span class="royal-crown-banner-detail">現代校園｜小班教學｜銜接全球大學</span>
      </span>
      <span class="royal-crown-banner-cta">探索加拿大升學 <span aria-hidden="true">↗</span></span>
    </a>
  </aside>
) : (
  <aside class:list={['ad-placement', format]} aria-label={`廣告：${description}`} data-ad-placement={placement}>
    <div class="ad-placement-label">ADVERTISEMENT · 廣告</div>
    <div class="ad-placement-content">
      <div>
        <span class="ad-placement-kicker">GLOBAL EDUCATION NEWS</span>
        <strong>大學與國際教育招生合作</strong>
        <p>讓有興趣的學生在探索學校與申請資訊時，看見您的課程與活動。</p>
      </div>
      <a href={inquiry}>洽詢此版位 <span aria-hidden="true">↗</span></a>
    </div>
  </aside>
)}
<style>
  .ad-placement{box-sizing:border-box;max-width:1240px;margin:38px auto;padding:14px 20px 20px;border:1px solid #d5c7b1;border-top:3px double #aa854e;background:#f8f5ee;color:#18334d}
  .ad-placement-label{font:700 .68rem/1.4 Arial,sans-serif;letter-spacing:.18em;color:#6c604f}
  .ad-placement-content{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:12px}
  .ad-placement-kicker{display:block;font:700 .68rem/1.4 Arial,sans-serif;letter-spacing:.15em;color:#86673b}
  .ad-placement strong{display:block;margin:6px 0;font:700 clamp(1.15rem,2vw,1.45rem)/1.3 Georgia,"Noto Serif TC",serif}
  .ad-placement p{margin:0;color:#4b5861;font-size:.9rem;line-height:1.6}
  .ad-placement a{flex:none;padding:11px 16px;border:1px solid #213d57;color:#18334d;text-decoration:none;font-weight:700;font-size:.88rem}
  .ad-placement a:hover,.ad-placement a:focus-visible{background:#18334d;color:#fff}
  .ad-placement.card{max-width:760px}
  .royal-crown-banner{padding:11px 11px 12px;background:#071c43;border-color:#c9a552;border-top-color:#c9a552}
  .royal-crown-banner .ad-placement-label{margin:0 5px 8px;color:#ead69b}
  .royal-crown-banner-link{position:relative;display:flex;align-items:center;justify-content:space-between;gap:22px;height:126px;padding:0 24px;border:0;overflow:hidden;background:#071c43;color:#fff;text-align:left}
  .royal-crown-banner-link:hover,.royal-crown-banner-link:focus-visible{background:#071c43;outline:3px solid #e4bc5d;outline-offset:3px}
  .royal-crown-banner-link::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,24,62,.97) 0%,rgba(5,24,62,.83) 43%,rgba(5,24,62,.22) 69%,rgba(5,24,62,.38) 100%);pointer-events:none}
  .royal-crown-banner img{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:center 15%;transition:transform .25s ease}
  .royal-crown-banner-link:hover img{transform:scale(1.008)}
  .royal-crown-banner-copy{position:relative;z-index:1;display:flex;min-width:0;flex-direction:column;justify-content:center}
  .royal-crown-banner-eyebrow{margin-bottom:2px;color:#e9c86b;font:700 .64rem/1.2 Arial,sans-serif;letter-spacing:.11em}
  .royal-crown-banner-copy strong{margin:0;color:#f4d67e;font:700 clamp(1.35rem,2.4vw,2.15rem)/1 Georgia,"Times New Roman",serif;letter-spacing:.025em;white-space:nowrap}
  .royal-crown-banner-feature{margin-top:4px;color:#fff;font:700 clamp(.84rem,1.45vw,1.18rem)/1.15 Georgia,"Noto Serif TC",serif;white-space:nowrap}
  .royal-crown-banner-detail{margin-top:3px;color:#eef3fa;font:600 .7rem/1.2 Arial,"Noto Sans TC",sans-serif;letter-spacing:.035em}
  .royal-crown-banner-cta{position:relative;z-index:1;flex:none;padding:10px 16px;border:1px solid #e4bc5d;border-radius:999px;background:rgba(5,24,62,.8);color:#f8df99;font:700 .8rem/1 Arial,"Noto Sans TC",sans-serif;white-space:nowrap}
  @media(max-width:640px){.ad-placement{margin:28px 12px;padding:13px 15px 16px}.ad-placement-content{align-items:flex-start;flex-direction:column;gap:13px}.ad-placement a{width:100%;box-sizing:border-box;text-align:center}}
  @media(max-width:640px){.royal-crown-banner{padding:9px}.royal-crown-banner-link{width:auto;height:90px;padding:0 10px;gap:8px;text-align:left}.royal-crown-banner img{object-position:center 15%}.royal-crown-banner-link::after{background:linear-gradient(90deg,rgba(5,24,62,.97) 0%,rgba(5,24,62,.8) 62%,rgba(5,24,62,.24) 100%)}.royal-crown-banner-eyebrow,.royal-crown-banner-detail{display:none}.royal-crown-banner-copy strong{font-size:1rem}.royal-crown-banner-feature{font-size:.7rem}.royal-crown-banner-cta{padding:7px 8px;font-size:.62rem}}
</style>
