---
const brevoFormUrl = 'https://34e9f212.sibforms.com/serve/MUIFAMWsiw0zELFOuqd9HloJYAXCi0Mjn703rO7DXLXU5xuIeKJnAYRUWC4Cd4YYc1CWWQ7464Iv2O_rk_8JkB-d4X7rdcJ9M95HlXlUfY88t3GdDBAHf9_03_vih0DqoBOSaYgRgVMX8TjoG7fzfDjVswKzSeEHJ4NnrThfbG25GWpERLjWBdi1r2Rj7icplVsAAmoPHxH8mJ1IHA==';
const { compact = false } = Astro.props;
---
<section class:list={["newsletter-cta", compact && "newsletter-cta-compact"]} aria-label="Global Education Weekly 國際教育週報">
  <div class="newsletter-rule">GLOBAL EDUCATION WEEKLY</div>
  <div class="newsletter-grid">
    <div class="newsletter-copy">
      <div class="kicker">FREE NEWSLETTER · 免費電子報</div>
      <h2>每週國際教育週報</h2>
      <p>免費加入會員，每週收到台灣與全球大學招生、留學政策、國際高中與教育趨勢，以及 Peter 精選觀點。</p>
      <small>採雙重確認訂閱（Double opt-in）· 免費訂閱 · 隨時可取消</small>
    </div>
    <div class="newsletter-embed-wrap">
      <iframe
        class="newsletter-embed"
        src={brevoFormUrl}
        title="訂閱 Global Education Weekly 國際教育週報"
        loading="lazy"
        scrolling="auto"
        frameborder="0"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  </div>
</section>

<style>
.newsletter-cta {
  margin: 34px 0 40px;
  padding: 0 0 24px;
  border-top: 3px double var(--line-dark);
  border-bottom: 1px solid var(--line-dark);
}
.newsletter-rule {
  padding: 8px 0 7px;
  border-bottom: 1px solid var(--line);
  font-family: Arial, "Noto Sans TC", sans-serif;
  font-size: .62rem;
  font-weight: 800;
  letter-spacing: .18em;
  color: var(--burgundy);
}
.newsletter-grid {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(440px, 1.1fr);
  gap: 30px;
  align-items: center;
  padding-top: 22px;
}
.newsletter-cta h2 {
  margin: 5px 0 8px;
  padding: 0;
  border: 0;
  font-family: Georgia, "Noto Serif TC", serif;
  font-size: clamp(1.75rem, 3.4vw, 2.8rem);
  line-height: 1.06;
}
.newsletter-cta p {
  margin: 0;
  max-width: 720px;
  color: var(--muted);
  font-size: 1rem;
}
.newsletter-copy small {
  display: block;
  margin-top: 10px;
  font-family: Arial, "Noto Sans TC", sans-serif;
  font-size: .68rem;
  color: var(--muted);
}
.newsletter-embed-wrap {
  width: 100%;
  max-width: 600px;
  margin-left: auto;
  overflow: hidden;
  border: 1px solid var(--line);
  background: #fff;
}
.newsletter-embed {
  display: block;
  width: 100%;
  height: 330px;
  border: 0;
  background: #fff;
}
.newsletter-cta-compact { margin: 30px 0; }
.newsletter-cta-compact .newsletter-grid { grid-template-columns: 1fr; gap: 16px; }
.newsletter-cta-compact .newsletter-embed-wrap { margin-left: 0; max-width: 560px; }
.newsletter-cta-compact .newsletter-embed { height: 330px; }
@media (max-width: 860px) {
  .newsletter-grid { grid-template-columns: 1fr; gap: 18px; }
  .newsletter-embed-wrap { margin-left: 0; max-width: 100%; }
}
@media (max-width: 560px) {
  .newsletter-embed { height: 365px; }
}
</style>
