---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const link = (path = '') => `${base}${path}`;

const modules = [
  ['01', 'Policy Radar', '全球教育政策雷達', 'intelligence/policy/'],
  ['02', 'Admission Tracker', '全球大學入學追蹤', 'intelligence/admissions/'],
  ['03', 'Global Education Index', '全球教育指數', 'intelligence/global-index/'],
  ['04', 'Taiwan AI Index', '台灣高中 AI 教育力指數', 'intelligence/taiwan-ai-index/'],
  ['05', 'Research & White Paper', '研究與教育白皮書', 'intelligence/research/']
];
---
<section class="gei-promo">
  <div class="container gei-promo-inner">
    <div class="gei-intro">
      <div class="gei-kicker">GLOBAL EDUCATION INTELLIGENCE · GEI</div>
      <h2>從教育新聞，走向教育情報。</h2>
      <p>持續追蹤政策、招生、教育指標與 AI 教育發展，把每天的新聞累積成可搜尋、可比較、可回溯的教育資料。</p>
      <a class="gei-button" href={link('intelligence/')}>進入全球教育情報中心 →</a>
    </div>
    <div class="gei-modules">
      {modules.map(([number, en, zh, href]) => (
        <a href={link(href)}>
          <span>{number}</span>
          <div><strong>{en}</strong><small>{zh}</small></div>
          <b>→</b>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .gei-promo { margin-top: 18px; background: #172235; color: #f7f3ea; border-top: 5px solid #9a7536; border-bottom: 1px solid #0c1421; }
  .gei-promo-inner { display: grid; grid-template-columns: .92fr 1.08fr; gap: 46px; padding-top: 42px; padding-bottom: 42px; }
  .gei-kicker { font-family: Arial, "Noto Sans TC", sans-serif; font-size: .66rem; font-weight: 900; letter-spacing: .17em; color: #d0b476; }
  .gei-intro h2 { margin: 8px 0 13px; font-size: clamp(2rem, 4vw, 3.65rem); line-height: 1.02; letter-spacing: -.035em; color: #fffdf8; }
  .gei-intro p { max-width: 520px; margin: 0; color: #d6dbe3; }
  .gei-button { display: inline-flex; margin-top: 20px; padding: 9px 13px; border: 1px solid #c8ad76; font-family: Arial, "Noto Sans TC", sans-serif; font-size: .72rem; font-weight: 900; color: #f6e9ca; }
  .gei-button:hover { background: #f4f0e7; color: #172235; }
  .gei-modules { border-top: 1px solid #47546a; }
  .gei-modules a { display: grid; grid-template-columns: 38px 1fr auto; gap: 15px; align-items: center; min-height: 66px; border-bottom: 1px solid #47546a; color: #f7f3ea; }
  .gei-modules a:hover { color: #e7cb8e; }
  .gei-modules span { font-family: Arial, sans-serif; font-size: .6rem; font-weight: 900; color: #c7aa70; }
  .gei-modules strong { display: block; font-family: Arial, sans-serif; font-size: .72rem; letter-spacing: .04em; }
  .gei-modules small { display: block; margin-top: 2px; color: #bcc4cf; font-size: .82rem; }
  .gei-modules b { font-family: Arial, sans-serif; color: #c7aa70; }
  @media (max-width: 780px) { .gei-promo-inner { grid-template-columns: 1fr; gap: 28px; } }
</style>
