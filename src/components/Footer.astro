---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const link = (path = '') => `${base}${path}`;
const peterFacebook = 'https://www.facebook.com/profile.php?id=61585164670358';
const editorialEmail = 'editor.jsti.ltu@gmail.com';
---
<footer class="footer">
  <div class="container">
    <div>
      <h3>Global Education News</h3>
      <p>聚焦國際教育、全球大學、招生政策、學生流動與教育制度的新聞與深度分析。</p>
      <p><a href={link('newsletter/')}><strong>Global Education Weekly｜免費電子報</strong></a></p>
      <p><a href={link('peter/')}><strong>Peter的國際教育講座</strong></a></p>
      <p><a href={peterFacebook} target="_blank" rel="noopener noreferrer">Facebook 粉絲專頁 ↗</a></p>
      <small>© 2026 Global Education News. All rights reserved.</small>
    </div>
    <div>
      <h3>編輯資訊</h3>
      <p><a href={link('about/')}>關於我們</a></p>
      <p><a href={link('editorial-policy/')}>編輯政策</a></p>
      <p><a href={link('corrections/')}>更正政策</a></p>
      <p><a href={`mailto:${editorialEmail}`}>{editorialEmail}</a></p>
    </div>
    <div>
      <h3>合作與透明度</h3>
      <p><a href={link('advertise/')}>廣告合作</a></p>
      <p><a href={link('contact/')}>聯絡我們</a></p>
      <p><a href={link('disclosure/')}>利益揭露與合作內容</a></p>
      <p><a href={link('privacy/')}>隱私權政策</a></p>

      <div class="readership-counter" aria-label="網站瀏覽統計">
        <div class="readership-kicker">READERSHIP</div>
        <div class="readership-total">累積瀏覽 <strong id="visitor-count">—</strong></div>
        <div class="readership-today">今日 <span id="visitor-today">—</span></div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const counterKey = 'ltu-global-education-news-20260831';
    const totalEl = document.getElementById('visitor-count');
    const todayEl = document.getElementById('visitor-today');

    fetch('https://visitor.6developer.com/visit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        domain: counterKey,
        timezone: 'Asia/Taipei'
      })
    })
      .then((response) => {
        if (!response.ok) throw new Error('Counter unavailable');
        return response.json();
      })
      .then((data) => {
        const total = Number(data.totalCount ?? 0);
        const today = Number(data.todayCount ?? 0);
        if (totalEl) totalEl.textContent = total.toLocaleString('zh-TW');
        if (todayEl) todayEl.textContent = today.toLocaleString('zh-TW');
      })
      .catch(() => {
        if (totalEl) totalEl.textContent = '統計中';
        if (todayEl) todayEl.textContent = '—';
      });
  })();
</script>

<style>
  .readership-counter {
    margin-top: 22px;
    padding: 15px 0 4px;
    border-top: 3px double #a49a8a;
    color: #ddd7cd;
  }
  .readership-kicker {
    margin-bottom: 5px;
    font-family: Arial, "Noto Sans TC", sans-serif;
    font-size: .61rem;
    font-weight: 800;
    letter-spacing: .19em;
    color: #c7a866;
  }
  .readership-total {
    font-family: Georgia, "Noto Serif TC", serif;
    font-size: .92rem;
  }
  .readership-total strong {
    margin-left: 4px;
    font-size: 1.28rem;
    font-weight: 700;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .readership-today {
    margin-top: 2px;
    font-family: Arial, "Noto Sans TC", sans-serif;
    font-size: .67rem;
    color: #aaa397;
  }
  .readership-today span {
    color: #d9d2c7;
    font-variant-numeric: tabular-nums;
  }
</style>
