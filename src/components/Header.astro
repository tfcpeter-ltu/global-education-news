---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const link = (path = '') => `${base}${path}`;
const peterFacebook = 'https://www.facebook.com/profile.php?id=61585164670358';
---
<header class="site-header">
  <div class="utility">
    <div class="container utility-inner">
      <span>環球教育新聞 · TAIWAN EDITION · EST. 2026</span>
      <span>INTERNATIONAL EDUCATION · UNIVERSITIES · POLICY · GLOBAL MOBILITY</span>
    </div>
  </div>

  <div class="container masthead bilingual-masthead version-c-masthead">
    <div class="masthead-side masthead-left">International Education<br />Journalism &amp; Analysis</div>
    <a class="brand bilingual-brand version-c-brand" href={link()} aria-label="Global Education News 環球教育新聞 首頁">
      <div class="brand-title-stack">
        <div class="brand-en-primary">Global Education News</div>
        <div class="brand-zh-secondary">環球教育新聞</div>
      </div>
      <div class="brand-subtitle">國際教育新聞・升學政策・全球高等教育分析</div>
      <div class="brand-subtitle-en">INTERNATIONAL EDUCATION NEWS · POLICY · ADMISSIONS · GLOBAL HIGHER EDUCATION</div>
    </a>
    <div class="masthead-side masthead-right">Taiwan · Asia<br />Global Perspective</div>
  </div>

  <div class="masthead-rule container" aria-hidden="true"><span></span></div>

  <nav class="nav" aria-label="主要導覽">
    <div class="container">
      <a href={link()}>首頁</a>
      <a href={link('news/')}>最新新聞</a>
      <a href={link('topics/taiwan/')}>台灣</a>
      <a href={link('topics/us/')}>美國</a>
      <a href={link('topics/canada/')}>加拿大</a>
      <a href={link('topics/uk/')}>英國</a>
      <a href={link('topics/australia/')}>澳洲</a>
      <a href={link('topics/asia/')}>亞洲</a>
      <a href={link('topics/admissions/')}>大學招生</a>
      <a href={link('topics/policy/')}>留學政策</a>
      <a href={link('insight/')}>深度專題</a>
      <a class="peter-nav" href={link('peter/')}>Peter的國際教育講座</a>
      <a class="peter-nav" href={link('newsletter/')}>免費電子報</a>
      <a class="facebook-nav" href={peterFacebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
      <a class="intelligence-nav" href={link('intelligence/')}>教育情報 GEI</a>
    </div>
  </nav>
</header>

<style>
  .version-c-masthead {
    grid-template-columns: minmax(145px, .72fr) minmax(0, 5.2fr) minmax(145px, .72fr);
    gap: 22px;
    padding-top: 21px;
    padding-bottom: 16px;
  }

  .version-c-brand {
    min-width: 0;
    text-align: center;
  }

  .brand-title-stack {
    line-height: 1;
  }

  .brand-en-primary {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.85rem, 5vw, 4.8rem);
    font-weight: 700;
    letter-spacing: -.055em;
    line-height: .95;
    color: #161411;
    white-space: nowrap;
  }

  .brand-zh-secondary {
    margin-top: 9px;
    font-family: "Noto Serif TC", Georgia, serif;
    font-size: clamp(1.08rem, 1.7vw, 1.55rem);
    font-weight: 700;
    letter-spacing: .28em;
    padding-left: .28em;
    line-height: 1.2;
    color: #3f3a34;
  }

  .brand-subtitle {
    margin-top: 12px;
    font-family: "Noto Serif TC", Georgia, serif;
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .13em;
    color: #575149;
  }

  .brand-subtitle-en {
    margin-top: 3px;
    font-family: Arial, "Noto Sans TC", sans-serif;
    font-size: .53rem;
    letter-spacing: .115em;
    color: #7a7268;
  }

  .nav .intelligence-nav {
    color: var(--navy);
    font-weight: 900;
  }

  .nav .intelligence-nav::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    background: var(--gold);
  }

  @media (max-width: 980px) {
    .version-c-masthead {
      grid-template-columns: 1fr;
      padding-top: 18px;
    }

    .version-c-masthead .masthead-side {
      display: none;
    }

    .brand-en-primary {
      font-size: clamp(2.7rem, 8vw, 4.2rem);
    }

    .brand-zh-secondary {
      font-size: clamp(1.05rem, 2.8vw, 1.4rem);
    }
  }

  @media (max-width: 680px) {
    .brand-en-primary {
      font-size: clamp(2.25rem, 11vw, 3.25rem);
      white-space: normal;
      line-height: .98;
    }

    .brand-zh-secondary {
      margin-top: 8px;
      font-size: clamp(1rem, 5.5vw, 1.28rem);
      letter-spacing: .2em;
      padding-left: .2em;
    }

    .brand-subtitle {
      margin-top: 11px;
      font-size: .68rem;
      letter-spacing: .08em;
    }

    .brand-subtitle-en {
      display: none;
    }
  }
</style>
