---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const link = (path = '') => `${base}${path}`;
const isScholarshipRadar = Astro.url.pathname === '/scholarships/' || Astro.url.pathname === '/scholarships';
---
{isScholarshipRadar && <link rel="stylesheet" href={link('scholarship-royal.css?v=20260916-stacked')} />}
<header class="site-header">
  <div class="utility">
    <div class="container utility-inner">
      <span>環球教育新聞網 · TAIWAN EDITION · EST. 2026</span>
      <span>INTERNATIONAL EDUCATION · UNIVERSITIES · POLICY · GLOBAL MOBILITY</span>
    </div>
  </div>

  <div class="container masthead bilingual-masthead version-c-masthead">
    <div class="masthead-side masthead-left">International Education<br />Journalism &amp; Analysis</div>
    <a class="brand bilingual-brand version-c-brand" href={link()} aria-label="Global Education News 環球教育新聞網 首頁">
      <div class="brand-title-stack">
        <div class="brand-en-primary">Global Education News</div>
        <div class="brand-zh-secondary">環球教育新聞網</div>
      </div>
      <div class="brand-subtitle">國內外國際教育新聞・大學科系選擇與申請・獎學金雷達<br />深度探討文章-Peter 的國際教育講座</div>
      <div class="brand-subtitle-en">EDUCATION NEWS · UNIVERSITIES & ADMISSIONS · SCHOLARSHIPS · PETER’S INSIGHTS</div>
    </a>
    <div class="masthead-side masthead-right">Taiwan · Asia<br />Global Perspective</div>
  </div>

  <div class="masthead-rule container" aria-hidden="true"><span></span></div>

  <nav class="nav" aria-label="主要導覽">
    <div class="container">
      <a class="bilingual-nav" href={link()} aria-label="首頁 Home">
        <span>首頁</span>
        <small>Home</small>
      </a>
      <a class="bilingual-nav" href={link('news/')} aria-label="最新新聞 Latest News">
        <span>最新新聞</span>
        <small>Latest News</small>
      </a>
      <a class="bilingual-nav" href={link('topics/taiwan/')} aria-label="台灣高教 Taiwan Higher Ed">
        <span>台灣高教</span>
        <small>Taiwan Higher Ed</small>
      </a>
      <details class="overseas-menu">
        <summary class="bilingual-nav" aria-label="海外教育 Global Education">
          <span>海外教育 <span aria-hidden="true">▾</span></span>
          <small>Global Education</small>
        </summary>
        <div class="overseas-options">
          <a href={link('topics/us/')}>美國</a>
          <a href={link('topics/canada/')}>加拿大</a>
          <a href={link('topics/uk/')}>英國</a>
          <a href={link('topics/australia/')}>澳洲</a>
          <a href={link('topics/asia/')}>亞洲</a>
        </div>
      </details>
      <a class="bilingual-nav domestic-university-nav" href={link('taiwan-universities/')} aria-label="國內大學選校選系 University Explorer">
        <span>國內大學選校選系</span>
        <small>University Explorer</small>
      </a>
      <a class="bilingual-nav navigator-nav" href={link('study-abroad/')} aria-label="留學DIY導航 Study Abroad Navigator">
        <span>留學DIY導航</span>
        <small>Study Abroad Navigator</small>
      </a>
      <a class="bilingual-nav scholarship-nav" href={link('scholarships/')} aria-label="台灣國際獎學金雷達 Scholarship Radar">
        <span>台灣國際獎學金雷達</span>
        <small>Scholarship Radar</small>
      </a>
      <a class="bilingual-nav peter-nav" href={link('peter/')} aria-label="Peter的國際教育講座 Peter’s Education Talk">
        <span>Peter的國際教育講座</span>
        <small>Peter’s Education Talk</small>
      </a>
      <a class="bilingual-nav peter-nav" href={link('newsletter/')} aria-label="免費電子報 Free Newsletter">
        <span>免費電子報</span>
        <small>Free Newsletter</small>
      </a>
      <a class="bilingual-nav intelligence-nav" href={link('intelligence/')} aria-label="教育情報 GEI Education Intelligence">
        <span>教育情報 GEI</span>
        <small>Education Intelligence</small>
      </a>
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.overseas-menu').forEach((menu) => {
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .nav { overflow: visible; white-space: normal; position: relative; z-index: 20; }
  .nav .container { flex-wrap: wrap; gap: 8px 18px; padding-top: 8px; padding-bottom: 8px; }
  .overseas-menu { position: relative; }
  .overseas-menu summary { cursor: pointer; list-style: none; padding: 0; white-space: nowrap; }
  .overseas-menu summary::-webkit-details-marker { display: none; }
  .overseas-menu summary:focus-visible { outline: 2px solid var(--burgundy); outline-offset: 4px; }
  .overseas-menu[open] summary { color: var(--burgundy); }
  .overseas-options { position: absolute; top: 100%; left: 0; min-width: 140px; padding: 6px; background: var(--sheet); border: 1px solid var(--line); box-shadow: 0 8px 20px #0002; }
  .overseas-options a { display: block; padding: 11px 16px; white-space: nowrap; }
  .overseas-options a:hover, .overseas-options a:focus-visible { background: var(--soft); }

  .version-c-masthead {
    grid-template-columns: minmax(145px, .72fr) minmax(0, 5.2fr) minmax(145px, .72fr);
    gap: 22px;
    padding-top: 21px;
    padding-bottom: 16px;
  }

  .version-c-brand {
    min-width: 0;
    text-align: center;
  }

  .brand-title-stack {
    line-height: 1;
  }

  .brand-en-primary {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.85rem, 5vw, 4.8rem);
    font-weight: 700;
    letter-spacing: -.055em;
    line-height: .95;
    color: #161411;
    white-space: nowrap;
  }

  .brand-zh-secondary {
    margin-top: 9px;
    font-family: "Noto Serif TC", Georgia, serif;
    font-size: clamp(1.08rem, 1.7vw, 1.55rem);
    font-weight: 700;
    letter-spacing: .28em;
    padding-left: .28em;
    line-height: 1.2;
    color: #3f3a34;
  }

  .brand-subtitle {
    margin-top: 12px;
    font-family: "Noto Serif TC", Georgia, serif;
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .13em;
    color: #575149;
  }

  .brand-subtitle-en {
    margin-top: 3px;
    font-family: Arial, "Noto Sans TC", sans-serif;
    font-size: .53rem;
    letter-spacing: .115em;
    color: #7a7268;
  }

  .nav .bilingual-nav {
    display: inline-flex;
    min-height: 43px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .nav .bilingual-nav small {
    color: #87652f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: .54rem;
    font-weight: 700;
    letter-spacing: .04em;
    white-space: nowrap;
  }

  .nav .domestic-university-nav,
  .nav .navigator-nav {
    color: #0f3b5f;
    font-weight: 900;
  }

  .nav .domestic-university-nav::after,
  .nav .navigator-nav::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    background: #b18a4d;
  }

  .nav .scholarship-nav {
    color: #9a5a06;
    font-weight: 900;
  }

  .nav .scholarship-nav::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    background: #d89a2b;
  }

  .nav .intelligence-nav {
    color: var(--navy);
    font-weight: 900;
  }

  .nav .intelligence-nav::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    background: var(--gold);
  }

  @media (max-width: 980px) {
    .version-c-masthead {
      grid-template-columns: 1fr;
      padding-top: 18px;
    }

    .version-c-masthead .masthead-side {
      display: none;
    }

    .brand-en-primary {
      font-size: clamp(2.7rem, 8vw, 4.2rem);
    }

    .brand-zh-secondary {
      font-size: clamp(1.05rem, 2.8vw, 1.4rem);
    }
  }

  @media (max-width: 680px) {
    .nav {
      overflow-x: hidden;
    }

    .nav .container {
      gap: 7px 16px;
    }

    .nav .bilingual-nav {
      min-height: 40px;
    }

    .nav .bilingual-nav small {
      font-size: .52rem;
    }

    .brand-en-primary {
      font-size: clamp(2.25rem, 11vw, 3.25rem);
      white-space: normal;
      line-height: .98;
      overflow-wrap: anywhere;
    }

    .brand-zh-secondary {
      margin-top: 8px;
      font-size: clamp(1rem, 5.5vw, 1.28rem);
      letter-spacing: .2em;
      padding-left: .2em;
    }

    .brand-subtitle {
      margin-top: 11px;
      font-size: .68rem;
      letter-spacing: .08em;
    }

    .brand-subtitle-en {
      display: none;
    }
  }
</style>
