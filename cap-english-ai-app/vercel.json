{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../cap-ai-preview",
  "rewrites": [
    { "source": "/api/practice/:path*", "destination": "/api/practice?practiceRoute=:path*" },
    { "source": "/api/notebook/:path*", "destination": "/api/notebook?notebookRoute=:path*" },
    { "source": "/api/progress/:path*", "destination": "/api/progress?progressRoute=:path*" },
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" }
  ]
}
