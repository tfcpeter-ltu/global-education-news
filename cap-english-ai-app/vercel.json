{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "cap-ai-preview": true
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/auth/me", "destination": "/api/auth-me" },
    { "source": "/api/paypal/:path*", "destination": "/api/payment?provider=paypal&paymentRoute=:path*" },
    { "source": "/api/newebpay/:path*", "destination": "/api/payment?provider=newebpay&paymentRoute=:path*" },
    { "source": "/api/practice/:path*", "destination": "/api/practice?practiceRoute=:path*" },
    { "source": "/api/notebook/:path*", "destination": "/api/notebook?notebookRoute=:path*" },
    { "source": "/api/progress/:path*", "destination": "/api/progress?progressRoute=:path*" },
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" }
  ]
}
