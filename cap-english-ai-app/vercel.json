{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "cap-ai-preview": true
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/tutor",
      "destination": "/api/tutor?route=chat"
    },
    {
      "source": "/api/math/:action",
      "destination": "/api/math?action=:action"
    },
    {
      "source": "/api/math-paypal/:path*",
      "destination": "/api/math-payment?provider=paypal&paymentRoute=:path*"
    },
    {
      "source": "/api/math-newebpay/:path*",
      "destination": "/api/math-payment?provider=newebpay&paymentRoute=:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin?adminRoute=:path*"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth-me"
    },
    {
      "source": "/api/paypal/:path*",
      "destination": "/api/payment?provider=paypal&paymentRoute=:path*"
    },
    {
      "source": "/api/newebpay/:path*",
      "destination": "/api/payment?provider=newebpay&paymentRoute=:path*"
    },
    {
      "source": "/api/practice/:path*",
      "destination": "/api/practice?practiceRoute=:path*"
    },
    {
      "source": "/api/notebook/:path*",
      "destination": "/api/notebook?notebookRoute=:path*"
    },
    {
      "source": "/api/progress/:path*",
      "destination": "/api/progress?progressRoute=:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        }
      ]
    }
  ]
}
